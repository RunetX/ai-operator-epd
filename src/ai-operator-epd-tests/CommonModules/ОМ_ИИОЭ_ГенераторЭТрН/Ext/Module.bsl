// Генератор состояний ЭТрН для тестов и демо: ЭТрН по реализации создается штатными вызовами БЭД
// (значения заполнения, запись, «Сформировать»), а дальше доводится до нужного состояния так же, как его
// доводит синхронизация ЭДО: отправка Т1, входящие титулы перевозчика и грузополучателя, отказ, ошибка оператора.
// Эталон - записи, которые создает типовой путь БЭД на демо-базе УТ 11.5.27. Только для тестового стенда:
// настройки ЭДО синтетические, подписи нет, к операторам ничего не уходит. Обратная операция - Удалить.

#Область СлужебныйПрограммныйИнтерфейс

// Коды состояний, которые умеет генератор.
//
// Возвращаемое значение:
//  Массив из Строка - Коды диагноза ИИОЭ_Диагностика (кроме DELETED и OTHER), T1_ERROR - временная ошибка
//    оператора, T1_ERROR_BLOCKING - ошибка, которую исправляют в форме.
Функция Состояния() Экспорт

	Возврат СтрРазделить("T1_NOT_FORMED,T1_NOT_SENT,T1_ERROR,T1_ERROR_BLOCKING,T1_REJECTED,"
		+ "WAIT_T2,WAIT_T3,WAIT_T4,DONE", ",");

КонецФункции

// Параметры генерации по умолчанию.
//
// Возвращаемое значение:
//  Структура:
//   * ДнейНазад - Число - Сколько дней назад было последнее событие по перевозке.
//   * Перевозчик - СправочникСсылка.Контрагенты - По умолчанию первый контрагент-юрлицо с ИНН.
//   * Водитель - Структура - Фамилия, Имя, Отчество, СерияВУ, НомерВУ.
//   * ПричинаОтказа - Строка - Комментарий перевозчика к отказу (T1_REJECTED).
Функция НовыеПараметры() Экспорт

	Параметры = Новый Структура;
	Параметры.Вставить("ДнейНазад", 3);
	Параметры.Вставить("Перевозчик", Справочники.Контрагенты.ПустаяСсылка());
	Параметры.Вставить("Водитель", Новый Структура("Фамилия, Имя, Отчество, СерияВУ, НомерВУ",
		"Тестовый", "Водитель", "Генераторович", "7700", "123456"));
	Параметры.Вставить("ПричинаОтказа", "Транспортное средство не подано под погрузку");
	Возврат Параметры;

КонецФункции

// Создает ЭТрН по реализации в заданном состоянии. Настройки ЭДО организации и контрагентов создаются,
// если их нет (см. НастроитьЭДО).
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг
//  Состояние - Строка - Один из кодов Состояния().
//  Параметры - см. НовыеПараметры
//
// Возвращаемое значение:
//  ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
Функция СоздатьЭТрН(Реализация, Состояние, Параметры = Неопределено) Экспорт

	Если Состояния().Найти(Состояние) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("Генератор не знает состояния %1", Состояние);
	КонецЕсли;
	Параметры = ?(Параметры = Неопределено, НовыеПараметры(), Параметры);
	Перевозчик = ?(ЗначениеЗаполнено(Параметры.Перевозчик), Параметры.Перевозчик, ПеревозчикПоУмолчанию());
	Участники = НастроитьЭДО(Реализация, Перевозчик);

	ЭТрН = ЗаписатьЭТрН(Реализация, Перевозчик, Участники, Параметры.Водитель);
	Если Состояние = "T1_NOT_FORMED" Тогда
		СдвинутьДатуЭТрН(ЭТрН, Параметры.ДнейНазад);
		Возврат ЭТрН;
	КонецЕсли;

	Сформировать(ЭТрН);
	ЭлектронныйДокумент = ЭлектронныйДокумент(ЭТрН);
	Если Состояние = "T1_NOT_SENT" Тогда
		СдвинутьСообщения(ЭлектронныйДокумент, Параметры.ДнейНазад);
		Возврат ЭТрН;
	ИначеЕсли Состояние = "T1_ERROR" Или Состояние = "T1_ERROR_BLOCKING" Тогда
		ЗаписатьОшибкуОператора(ЭлектронныйДокумент, Состояние = "T1_ERROR_BLOCKING");
		СдвинутьСообщения(ЭлектронныйДокумент, Параметры.ДнейНазад);
		Возврат ЭТрН;
	КонецЕсли;

	ИИОЭ_Транспорт.ОтметитьОтправкуТитула(ЭТрН.ПолучитьОбъект());
	Входящие = Новый Массив;
	Если Состояние = "T1_REJECTED" Тогда
		Входящие.Добавить("ЭТрН_ОткП");
	ИначеЕсли Состояние = "WAIT_T3" Тогда
		Входящие.Добавить("ЭТрН_Титул2");
	ИначеЕсли Состояние = "WAIT_T4" Тогда
		Входящие.Добавить("ЭТрН_Титул2");
		Входящие.Добавить("ЭТрН_Титул3");
	ИначеЕсли Состояние = "DONE" Тогда
		Входящие.Добавить("ЭТрН_Титул2");
		Входящие.Добавить("ЭТрН_Титул3");
		Входящие.Добавить("ЭТрН_Титул4");
	КонецЕсли;
	// Входящие титулы приходят после отправки Т1, по часу между ними; затем вся история сдвигается назад.
	Для Индекс = 0 По Входящие.ВГраница() Цикл
		ДобавитьВходящийТитул(ЭлектронныйДокумент, Входящие[Индекс], ТекущаяДатаСеанса() + (Индекс + 1) * 3600);
	КонецЦикла;
	Если Состояние = "T1_REJECTED" Тогда
		УстановитьСостояниеДокумента(ЭлектронныйДокумент, Перечисления.СостоянияДокументовЭДО.ЗакрытСОтклонением,
			Параметры.ПричинаОтказа);
	ИначеЕсли Состояние = "DONE" Тогда
		УстановитьСостояниеДокумента(ЭлектронныйДокумент, Перечисления.СостоянияДокументовЭДО.ОбменЗавершен, "");
	КонецЕсли;
	СдвинутьСообщения(ЭлектронныйДокумент, Параметры.ДнейНазад + Входящие.Количество() / 24);
	// Запись ЭТрН пересчитывает шаг документооборота по последнему сообщению.
	ЭТрН.ПолучитьОбъект().Записать(РежимЗаписиДокумента.Запись);
	Возврат ЭТрН;

КонецФункции

// Синтетические настройки ЭДО для «Сформировать»: учетная запись организации, настройки отправки ЭТрН перевозчику
// и грузополучателю, принятые приглашения (без них БЭД снимает актуальность электронного документа при следующей
// записи ЭТрН) и отметка о сегодняшней синхронизации форматов (иначе «Сформировать» идет в сервис настроек ЭДО).
//
// Параметры:
//  Реализация - ДокументСсылка.РеализацияТоваровУслуг
//  Перевозчик - СправочникСсылка.Контрагенты
//
// Возвращаемое значение:
//  Структура - Идентификаторы ЭДО: Грузоотправитель, Перевозчик, Грузополучатель.
Функция НастроитьЭДО(Реализация, Перевозчик) Экспорт

	Реквизиты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Реализация, "Организация, Контрагент");
	Участники = Новый Структура;
	Участники.Вставить("Грузоотправитель", ИдентификаторУчастника(Реквизиты.Организация));
	Участники.Вставить("Перевозчик", ИдентификаторУчастника(Перевозчик));
	Участники.Вставить("Грузополучатель", ИдентификаторУчастника(Реквизиты.Контрагент));

	Запись = РегистрыСведений.УчетныеЗаписиЭДО.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторЭДО = Участники.Грузоотправитель;
	Запись.Прочитать();
	Если Не Запись.Выбран() Тогда
		Запись.ИдентификаторЭДО = Участники.Грузоотправитель;
		Запись.Организация = Реквизиты.Организация;
		Запись.НаименованиеУчетнойЗаписи = "ИИ-оператор: тестовая учетная запись ЭТрН";
		Запись.ОператорЭДО = "2AE";
		Запись.СпособОбменаЭД = Перечисления.СпособыОбменаЭД.ЧерезСервис1СЭДО;
		Запись.ПринятыУсловияИспользования = Истина;
		Запись.ВидУчетнойЗаписи = Перечисления.ВидУчетнойЗаписиЭДО.ЮридическоеЛицо;
		Запись.Записать();
	КонецЕсли;

	ВидДокумента = ЭлектронныеДокументыЭДО.ВидДокументаПоТипу(Перечисления.ТипыДокументовЭДО.ЭТрН);
	Получатели = Новый Соответствие;
	Получатели.Вставить(Перевозчик, Участники.Перевозчик);
	Получатели.Вставить(Реквизиты.Контрагент, Участники.Грузополучатель);
	Для Каждого КлючИЗначение Из Получатели Цикл
		Настройка = РегистрыСведений.НастройкиОтправкиЭлектронныхДокументовПоВидам.СоздатьМенеджерЗаписи();
		Настройка.Отправитель = Реквизиты.Организация;
		Настройка.Получатель = КлючИЗначение.Ключ;
		Настройка.ВидДокумента = ВидДокумента;
		Настройка.СпособОбменаЭД = Перечисления.СпособыОбменаЭД.ЧерезСервис1СЭДО;
		Настройка.ИдентификаторОтправителя = Участники.Грузоотправитель;
		Настройка.ИдентификаторПолучателя = КлючИЗначение.Значение;
		Настройка.МаршрутПодписания = МаршрутыПодписанияБЭД.МаршрутОднойДоступнойПодписью();
		Настройка.Формировать = Истина;
		Настройка.ОбменБезПодписи = Истина;
		Настройка.Записать();
		ДобавитьПриглашение(Реквизиты.Организация, Участники.Грузоотправитель, КлючИЗначение.Ключ,
			КлючИЗначение.Значение);
	КонецЦикла;

	Синхронизация = РегистрыСведений.СостоянияСинхронизацииСервисНастроекЭДО.СоздатьМенеджерЗаписи();
	Синхронизация.ТипСинхронизации = Перечисления.ТипыСинхронизацииСервисаНастроекЭДО.СинхронизацияФорматовЭД;
	Синхронизация.Прочитать();
	Синхронизация.ТипСинхронизации = Перечисления.ТипыСинхронизацииСервисаНастроекЭДО.СинхронизацияФорматовЭД;
	Синхронизация.ДатаПоследнейПроверки = НачалоДня(ТекущаяДатаСеанса());
	Синхронизация.Записать();
	Возврат Участники;

КонецФункции

// Наполняет тестовый стенд: прежние ЭТрН генератора удаляются, по каждому состоянию создается одна ЭТрН
// на своей реализации, адрес мока оператора записывается в константу, текущему пользователю разрешается
// действие epd_send. Одна транзакция. Регламентное задание
// отправки QR-кодов, которое включает запись ЭТрН, возвращается в прежнее состояние.
//
// Параметры:
//  АдресМока - Строка - Адрес tests/mock/edo_mock.py, например http://127.0.0.1:8882.
//  Водитель - Структура, Неопределено - Водитель ЭТрН в состоянии WAIT_T3 (см. НовыеПараметры): для проверки
//    маскирования - человек из базы.
//
// Возвращаемое значение:
//  Строка - JSON: {"<состояние>": {"sale": ref, "etrn": ref, "number": ...}}.
Функция НаполнитьСтенд(АдресМока, Водитель = Неопределено) Экспорт

	Задание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.ОтправкаQRКодовЭПД);
	ЗаданиеИспользовалось = Задание.Использование;
	Дни = Новый Структура("T1_NOT_FORMED, T1_NOT_SENT, T1_ERROR, T1_ERROR_BLOCKING, T1_REJECTED, "
		+ "WAIT_T2, WAIT_T3, WAIT_T4, DONE", 5, 2, 1, 1, 1, 4, 6, 2, 3);
	Результат = Новый Структура;
	НачатьТранзакцию();
	Попытка
		Удалить(Созданные());
		Реализации = РеализацииДляНаполнения(Состояния().Количество());
		Для Индекс = 0 По Состояния().ВГраница() Цикл
			Состояние = Состояния()[Индекс];
			Параметры = НовыеПараметры();
			Параметры.ДнейНазад = Дни[Состояние];
			Если Состояние = "WAIT_T3" И Водитель <> Неопределено Тогда
				Параметры.Водитель = Водитель;
			КонецЕсли;
			ЭТрН = СоздатьЭТрН(Реализации[Индекс], Состояние, Параметры);
			Результат.Вставить(Состояние, Новый Структура("sale, etrn, number",
				ИИО_Ответ.СсылкаВСтроку(Реализации[Индекс]), ИИО_Ответ.СсылкаВСтроку(ЭТрН), ЭТрН.Номер));
		КонецЦикла;
		Константы.ИИОЭ_АдресТестовогоСервераОператораЭДО.Установить(АдресМока);
		// Повторную отправку разрешает администратор ИИ-оператора; на демо-стенде - тому, кто его наполняет.
		Разрешение = РегистрыСведений.ИИО_РазрешенияДействий.СоздатьМенеджерЗаписи();
		Разрешение.Пользователь = Пользователи.АвторизованныйПользователь();
		Разрешение.Действие = "epd_send";
		Разрешение.Разрешено = Истина;
		Разрешение.Записать();
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;
	Задание = РегламентныеЗадания.НайтиПредопределенное(Метаданные.РегламентныеЗадания.ОтправкаQRКодовЭПД);
	Если Задание.Использование <> ЗаданиеИспользовалось Тогда
		Задание.Использование = ЗаданиеИспользовалось;
		Задание.Записать();
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.ВJSON(Результат);

КонецФункции

// ЭТрН, созданные генератором: у них в комментарии метка генератора.
//
// Возвращаемое значение:
//  Массив из ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
Функция Созданные() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ЭТрН.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.ЭлектроннаяТранспортнаяНакладная КАК ЭТрН
	|ГДЕ
	|	ЭТрН.Комментарий = &Метка";
	Запрос.УстановитьПараметр("Метка", МеткаЭТрН());
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");

КонецФункции

// Удаляет ЭТрН, созданные генератором, со всеми записями ЭДО. Настройки ЭДО остаются.
//
// Параметры:
//  Накладные - Массив из ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
Процедура Удалить(Накладные) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Объекты.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	ИсходящиеДокументы.ИдентификаторДокументооборота КАК ИдентификаторДокументооборота
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК Объекты
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументИсходящийЭДО КАК ИсходящиеДокументы
	|		ПО Объекты.ЭлектронныйДокумент = ИсходящиеДокументы.Ссылка
	|ГДЕ
	|	Объекты.ОбъектУчета В (&Накладные)";
	Запрос.УстановитьПараметр("Накладные", Накладные);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		УдалитьЭлектронныйДокумент(Выборка.ЭлектронныйДокумент, Выборка.ИдентификаторДокументооборота);
	КонецЦикла;

	Для Каждого ЭТрН Из Накладные Цикл
		УдалитьЗаписиПоОтбору("ОбъектыУчетаДокументовЭДО", "ОбъектУчета", ЭТрН);
		УдалитьЗаписиПоОтбору("СостоянияПоОбъектамУчетаЭДО", "СсылкаНаОбъект", ЭТрН);
		УдалитьЗаписиПоОтбору("ВерсииТитуловЭПД", "Документ", ЭТрН);
		УдалитьЗаписиПоОтбору("ЗначенияРеквизитовДокументовЭПД", "Документ", ЭТрН);
		УдалитьЗаписиПоОтбору("РеестрЭПД", "Ссылка", ЭТрН);
		Объект = ЭТрН.ПолучитьОбъект();
		Если Объект <> Неопределено Тогда
			Объект.ОбменДанными.Загрузка = Истина;
			Объект.Удалить();
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ЭТрН

Функция ЗаписатьЭТрН(Реализация, Перевозчик, Участники, Водитель)

	// Запись ЭТрН по реализации - как форма ЭТрН перед «Отправить через ЭДО» (ОбменСГИСЭПДКлиент.ОтправитьЭПД):
	// значения заполнения БЭД, реквизиты перевозчика, идентификация файла обмена и данные, которые в форме вводит
	// пользователь. УИД Минтранса - синтетический: настоящий выдает оператор.
	ЗначенияЗаполнения = ОбменСГИСЭПДПереопределяемый.ЗначенияЗаполненияЭлектронныеТранспортныеНакладные(
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Реализация))[0];
	ЗначенияЗаполнения.СсылкаТитулГрузоотправителяПеревозчик = Перевозчик;
	СтрокаВодителя = Новый Структура("ИдентификаторСтроки, Фамилия, Имя, Отчество, СерияВУ, НомерВУ",
		"generator-driver-1", Водитель.Фамилия, Водитель.Имя, Водитель.Отчество, Водитель.СерияВУ, Водитель.НомерВУ);
	ЗначенияЗаполнения.ТитулГрузоотправителяВодители.Добавить(СтрокаВодителя);
	ЗначенияЗаполнения.Вставить("ТитулГрузоотправителяТранспортноеСредствоРегистрационныйНомер", "А001АА77");

	Объект = Документы.ЭлектроннаяТранспортнаяНакладная.СоздатьДокумент();
	Объект.Дата = ТекущаяДатаСеанса();
	Объект.УстановитьНовыйНомер();
	Реквизиты = ПлоскиеРеквизиты(ЗначенияЗаполнения);
	ДобавитьРеквизитыПеревозчика(Реквизиты, Перевозчик);
	ИдентификацияФайла = ДобавитьИдентификациюФайла(Реквизиты, Объект, Реализация, Участники);
	ДобавитьДанныеПользователя(Реквизиты, Объект.Дата);

	ВерсияТитула = Новый Структура("Титул, НомерВерсии, ИдентификаторФайла, ДатаВерсии",
		Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1, 0, ИдентификацияФайла.ИдентификаторФайла,
		ИдентификацияФайла.ДатаВерсии);
	Объект.ДополнительныеСвойства.Вставить("СтруктураРеквизитов", Новый ФиксированнаяСтруктура(Реквизиты));
	Объект.ДополнительныеСвойства.Вставить("ВерсияТитула", ВерсияТитула);
	Объект.ДополнительныеСвойства.Вставить("ЗаписьИзФормы", Истина);
	ЗаполнитьЗначенияСвойств(Объект, Реквизиты);
	Для Каждого Основание Из ЗначенияЗаполнения.ДокументыОснования Цикл
		Объект.ДокументыОснования.Добавить().ДокументОснование = Основание.ДокументОснование;
	КонецЦикла;
	Объект.ТекущийТитул = Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1;
	Объект.УИДМинтранс = ИдентификацияФайла.УИДМинтранс;
	Объект.ИдентификаторГрузоотправителя = Участники.Грузоотправитель;
	Объект.ИдентификаторПеревозчика = Участники.Перевозчик;
	Объект.ИдентификаторГрузополучателя = Участники.Грузополучатель;
	Объект.Комментарий = МеткаЭТрН();
	Объект.Записать(РежимЗаписиДокумента.Запись);
	Возврат Объект.Ссылка;

КонецФункции

Функция ПлоскиеРеквизиты(ЗначенияЗаполнения)

	// Ключи титула: строки табличных частей - <ТЧ>__<номер с 1>__<колонка>, как в
	// ОбменСГИСЭПД.ЗаполнитьТаблицуЗначенийРеквизитовПоПараметрамФормы для нового документа.
	Реквизиты = Новый Структура;
	Для Каждого КлючИЗначение Из ЗначенияЗаполнения Цикл
		Если ТипЗнч(КлючИЗначение.Значение) = Тип("Массив") Тогда
			Для НомерСтроки = 1 По КлючИЗначение.Значение.Количество() Цикл
				Для Каждого Колонка Из КлючИЗначение.Значение[НомерСтроки - 1] Цикл
					Реквизиты.Вставить(КлючИЗначение.Ключ + "__" + Формат(НомерСтроки, "ЧГ=0") + "__" + Колонка.Ключ,
						Колонка.Значение);
				КонецЦикла;
			КонецЦикла;
		Иначе
			Реквизиты.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;
	Возврат Реквизиты;

КонецФункции

Процедура ДобавитьРеквизитыПеревозчика(Реквизиты, Перевозчик)

	Префикс = "ТитулГрузоотправителяПеревозчик";
	Для Каждого КлючИЗначение Из ОбменСГИСЭПД.ПолучитьРеквизитыУчастника(Перевозчик, Ложь) Цикл
		Если КлючИЗначение.Ключ = "НомераТелефонов" Или КлючИЗначение.Ключ = "АдресаЭлектроннойПочты" Тогда
			Колонка = ?(КлючИЗначение.Ключ = "НомераТелефонов", "Телефон", "АдресЭлектроннойПочты");
			Для НомерСтроки = 1 По КлючИЗначение.Значение.Количество() Цикл
				Реквизиты.Вставить(Префикс + КлючИЗначение.Ключ + "__" + Формат(НомерСтроки, "ЧГ=0") + "__" + Колонка,
					КлючИЗначение.Значение[НомерСтроки - 1]);
			КонецЦикла;
		Иначе
			Реквизиты.Вставить(Префикс + КлючИЗначение.Ключ, КлючИЗначение.Значение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Функция ДобавитьИдентификациюФайла(Реквизиты, Объект, Реализация, Участники)

	// Идентификация файла обмена - как ОбменСГИСЭПДКлиент.ЗаполнитьИдентификациюФайлаОбмена_ПослеПолученияУИД
	// для Т1: имя файла ON_TRNACLGROT_ИдПЕР_ИдГП_ИдГО_0_ГГГГММДД_GUID, даты по UTC.
	Префикс = "ТитулГрузоотправителя";
	ИННОрганизации = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(
		ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Реализация, "Организация"), "ИНН");
	УниверсальнаяДата = ТекущаяУниверсальнаяДата();
	Идентификация = Новый Структура;
	Идентификация.Вставить("УИДМинтранс", Строка(Новый УникальныйИдентификатор));
	Идентификация.Вставить("ИдентификаторФайла", СтрШаблон("ON_TRNACLGROT_%1_%2_%3_0_%4_%5", Участники.Перевозчик,
		Участники.Грузополучатель, Участники.Грузоотправитель, Формат(УниверсальнаяДата, "ДФ=ггггММдд"),
		Новый УникальныйИдентификатор));
	Идентификация.Вставить("ДатаВерсии", УниверсальнаяДата);

	Реквизиты.Вставить(Префикс + "ТранспортнаяНакладнаяДата", Объект.Дата);
	Реквизиты.Вставить(Префикс + "ТранспортнаяНакладнаяНомер", Объект.Номер);
	Реквизиты.Вставить(Префикс + "СодержаниеОперации", "Лицом, осуществляющим погрузку груза, при указанных "
		+ "обстоятельствах передан водителю груз с указанными характеристиками");
	ВставитьЕслиНет(Реквизиты, Префикс + "ЗаказНомер", "Без номера");
	ВставитьЕслиНет(Реквизиты, Префикс + "УказанияВОтношенииВыполненияНормПеревозки", "Отсутствуют");
	ВставитьЕслиНет(Реквизиты, Префикс + "ЛицоОсуществляющееПогрузкуЯвляетсяГрузоотправителем", "1");
	ВставитьЕслиНет(Реквизиты, Префикс + "ВладелецПунктаПогрузкиЯвляетсяГрузоотправителем", "1");
	Реквизиты.Вставить(Префикс + "РеквизитыГрузоотправителяЮЛ_ИНН", ИННОрганизации);
	Реквизиты.Вставить(Префикс + "ИнойГрузоотправительЮЛ_ИНН", ИННОрганизации);
	Реквизиты.Вставить(Префикс + "УИДМинтранс", Идентификация.УИДМинтранс);
	Реквизиты.Вставить(Префикс + "ВерсияПрограммы", ОбменСГИСЭПД.НазваниеИВерсияПрограммы());
	Реквизиты.Вставить(Префикс + "ВерсияФормата",
		ОбменСГИСЭПДКлиентСервер.ВерсияФормата("ЭлектроннаяТранспортнаяНакладная"));
	Реквизиты.Вставить(Префикс + "КодДокументаПоКНД", "1110339");
	Реквизиты.Вставить(Префикс + "НаименованиеДокументаПоФХЖ", "Транспортная накладная, информация грузоотправителя");
	// Подписант заполняется из сертификата при подписании; до него БЭД ставит прочерки.
	Для Каждого Поле Из СтрРазделить("Фамилия,Имя,Отчество,Должность", ",") Цикл
		Реквизиты.Вставить(Префикс + "Подписант" + Поле, "---");
	КонецЦикла;
	Реквизиты.Вставить(Префикс + "ПодписантТипПодписи", "1");
	Реквизиты.Вставить(Префикс + "ПодписантКодСтатуса", "1");
	Реквизиты.Вставить(Префикс + "ПодписантСпособПодтвержденияПолномочий", "1");
	Реквизиты.Вставить(Префикс + "ИдентификаторФайла", Идентификация.ИдентификаторФайла);
	Реквизиты.Вставить(Префикс + "ДатаФормированияФайла", НачалоДня(УниверсальнаяДата));
	Реквизиты.Вставить(Префикс + "ВремяФормированияФайла",
		Дата(1, 1, 1) + (УниверсальнаяДата - НачалоДня(УниверсальнаяДата)));
	Возврат Идентификация;

КонецФункции

Процедура ДобавитьДанныеПользователя(Реквизиты, ДатаДокумента)

	// Данные, которые в форме ЭТрН вводит пользователь: без них проверка БЭД (ПроверитьЗаполнениеДокументаЭПД)
	// не пропускает формирование. Все значения синтетические.
	Префикс = "ТитулГрузоотправителя";
	ВставитьЕслиНет(Реквизиты, Префикс + "ЗаказДата", ДатаДокумента);
	ВставитьЕслиНет(Реквизиты, Префикс + "Экспедитор", "0");
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита(Реквизиты, Префикс + "ГрузополучательЮЛ_ИНН")) Тогда
		Реквизиты.Вставить(Префикс + "ГрузополучательЮЛ_ИНН", "7700000016");
		Реквизиты.Вставить(Префикс + "ГрузополучательЮЛ_КПП", "770001001");
	КонецЕсли;
	ВставитьЕслиНет(Реквизиты, Префикс + "ГрузополучательНомераТелефонов__1__Телефон", "+7 000 000-00-03");
	ВставитьЕслиНет(Реквизиты, Префикс + "ПеревозчикНомераТелефонов__1__Телефон", "+7 000 000-00-02");
	ВставитьЕслиНет(Реквизиты, Префикс + "ОтветственныйЗаПереадресовкуНомераТелефонов__1__Телефон", "+7 000 000-00-01");
	Реквизиты.Вставить(Префикс + "ВодительНомераТелефонов__1__Телефон", "+7 000 000-00-04");
	Реквизиты.Вставить(Префикс + "ВодительНомераТелефонов__1__ИдентификаторСтрокиРодителя", "generator-driver-1");
	Реквизиты.Вставить(Префикс + "ТранспортноеСредствоТипВладения", "1");
	Реквизиты.Вставить(Префикс + "ТранспортноеСредствоТип", "Грузовой фургон");
	Реквизиты.Вставить(Префикс + "ТранспортноеСредствоМарка", "ТЕСТ");
	Реквизиты.Вставить(Префикс + "ТранспортноеСредствоГрузоподъемность", 1.5);
	Реквизиты.Вставить(Префикс + "ТранспортноеСредствоВместимость", 10);
	Поля = СтрРазделить("ЗаявленныеДатаВремяПодачи,ФактическиеДатаВремяПодачи,ФактическиеДатаВремяУбытия", ",");
	Для Каждого Поле Из Поля Цикл
		Реквизиты.Вставить(Префикс + Поле, ДатаДокумента);
		Реквизиты.Вставить(Префикс + Поле + "ИспользуетсяUTC", Ложь);
	КонецЦикла;
	// У части реализаций демо-базы нет адреса склада: подставляется адрес склада эталонной реализации.
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита(Реквизиты, Префикс + "АдресПогрузкиУлица"))
		И Не ЗначениеЗаполнено(ЗначениеРеквизита(Реквизиты, Префикс + "АдресПогрузкиГород")) Тогда
		Реквизиты.Вставить(Префикс + "АдресПогрузкиИндекс", "119048");
		Реквизиты.Вставить(Префикс + "АдресПогрузкиКодРегиона", "77");
		Реквизиты.Вставить(Префикс + "АдресПогрузкиУлица", "10-летия Октября ул");
		Реквизиты.Вставить(Префикс + "АдресПогрузкиДом", "11");
	КонецЕсли;
	// Адреса контрагентов демо-базы разобраны не полностью: индекс и регион обязательны.
	Для Каждого Адрес Из СтрРазделить("ГрузополучательАдрес,ГрузополучательАдресДоставки", ",") Цикл
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита(Реквизиты, Префикс + Адрес + "Индекс")) Тогда
			Реквизиты.Вставить(Префикс + Адрес + "Индекс", "123022");
		КонецЕсли;
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита(Реквизиты, Префикс + Адрес + "КодРегиона")) Тогда
			Реквизиты.Вставить(Префикс + Адрес + "КодРегиона", "77");
		КонецЕсли;
	КонецЦикла;
	// В демо-базе не у всех товаров указан вес, а масса брутто в титуле обязательна.
	Если Не ЗначениеЗаполнено(ЗначениеРеквизита(Реквизиты, Префикс + "МассаБруттоГруза")) Тогда
		Реквизиты.Вставить(Префикс + "МассаБруттоГруза", 100);
	КонецЕсли;
	НомерСтроки = 1;
	Пока Реквизиты.Свойство(Префикс + "Грузы__" + Формат(НомерСтроки, "ЧГ=0") + "__ОтгрузочноеНаименованиеГруза") Цикл
		Ключ = Префикс + "Грузы__" + Формат(НомерСтроки, "ЧГ=0") + "__МассаБрутто";
		Если Не ЗначениеЗаполнено(ЗначениеРеквизита(Реквизиты, Ключ)) Тогда
			Реквизиты.Вставить(Ключ, 100);
		КонецЕсли;
		НомерСтроки = НомерСтроки + 1;
	КонецЦикла;
	Реквизиты.Вставить(Префикс + "КодМетодаОпределенияМассыГруза", "01");
	Реквизиты.Вставить(Префикс + "КоличествоГрузовыхМест", 5);

КонецПроцедуры

#КонецОбласти

#Область ДокументооборотЭДО

Процедура Сформировать(ЭТрН)

	// Стандартное действие «Сформировать» - первое действие набора, который запускает форма ЭТрН.
	Параметры = ЭлектронныеДокументыЭДОКлиентСервер.НовыеПараметрыВыполненияДействийПоЭДО();
	ЭлектронныеДокументыЭДОКлиентСервер.ДобавитьДействие(Параметры.НаборДействий,
		Перечисления.ДействияПоЭДО.Сформировать);
	Параметры.ОбъектыДействий.ОбъектыУчета.Добавить(ЭТрН);
	ЭлектронныеДокументыЭДО.ВыполнитьДействияПоИнтеграциямЭДО(Параметры);
	Если ЭлектронныйДокумент(ЭТрН) = Неопределено Тогда
		ВызватьИсключение СтрШаблон("БЭД не сформировала титул грузоотправителя по %1: %2",
			ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭТрН, "ДокументыОснования").Выгрузить()[0].ДокументОснование,
			ОшибкиЗаполненияБЭД(ЭТрН));
	КонецЕсли;

КонецПроцедуры

Функция ОшибкиЗаполненияБЭД(ЭТрН)

	Тексты = Новый Массив;
	Ошибки = ОбменСГИСЭПД.ПроверитьЗаполнениеДокументаЭПД(ЭТрН, Перечисления.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1,
		ЭлектронныеДокументыЭДО.ВидДокументаПоТипу(Перечисления.ТипыДокументовЭДО.ЭТрН));
	ДобавитьТекстыОшибок(Тексты, Ошибки);
	Возврат ?(Тексты.Количество() = 0, "проверка заполнения ошибок не нашла", СтрСоединить(Тексты, "; "));

КонецФункции

Процедура ДобавитьТекстыОшибок(Тексты, Ошибки)

	Текст = "";
	Если ТипЗнч(Ошибки) = Тип("Массив") Или ТипЗнч(Ошибки) = Тип("ФиксированныйМассив") Тогда
		Для Каждого Ошибка Из Ошибки Цикл
			ДобавитьТекстыОшибок(Тексты, Ошибка);
		КонецЦикла;
	ИначеЕсли (ТипЗнч(Ошибки) = Тип("Структура") Или ТипЗнч(Ошибки) = Тип("ФиксированнаяСтруктура"))
		И Ошибки.Свойство("Текст", Текст) Тогда
		Если ТипЗнч(Текст) = Тип("Массив") Или ТипЗнч(Текст) = Тип("ФиксированныйМассив") Тогда
			Части = Новый Массив;
			Для Каждого Часть Из Текст Цикл
				Части.Добавить(Строка(Часть));
			КонецЦикла;
			Текст = СтрСоединить(Части, " ");
		КонецЕсли;
		Тексты.Добавить(Текст);
	ИначеЕсли Ошибки <> Неопределено Тогда
		Тексты.Добавить(Строка(Ошибки));
	КонецЕсли;

КонецПроцедуры

Функция ЭлектронныйДокумент(ЭТрН)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Объекты.ЭлектронныйДокумент КАК ЭлектронныйДокумент
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК Объекты
	|ГДЕ
	|	Объекты.ОбъектУчета = &ЭТрН
	|	И Объекты.Актуальный";
	Запрос.УстановитьПараметр("ЭТрН", ЭТрН);
	Выборка = Запрос.Выполнить().Выбрать();
	Возврат ?(Выборка.Следующий(), Выборка.ЭлектронныйДокумент, Неопределено);

КонецФункции

Процедура ДобавитьВходящийТитул(ЭлектронныйДокумент, ИмяТипа, Дата)

	// Входящий титул контрагента в том же электронном документе: как его загружает синхронизация ЭДО,
	// но без файла титула (диагностике он не нужен).
	Исходящее = Документы.СообщениеЭДО.Выбрать(, , Новый Структура("ЭлектронныйДокумент", ЭлектронныйДокумент));
	Исходящее.Следующий();
	Сообщение = Документы.СообщениеЭДО.СоздатьДокумент();
	Сообщение.Дата = Дата;
	Сообщение.ЭлектронныйДокумент = ЭлектронныйДокумент;
	Сообщение.ВидСообщения = Исходящее.ВидСообщения;
	Сообщение.ТипЭлементаРегламента = Перечисления.ТипыЭлементовРегламентаЭДО[ИмяТипа];
	Сообщение.Направление = Перечисления.НаправленияЭДО.Входящий;
	Сообщение.Статус = Перечисления.СтатусыСообщенийЭДО.Получен;
	Сообщение.Состояние = Перечисления.СостоянияСообщенийЭДО.Хранение;
	Сообщение.ДатаИзмененияСтатуса = Дата;
	Сообщение.Записать();

КонецПроцедуры

Процедура УстановитьСостояниеДокумента(ЭлектронныйДокумент, Состояние, Комментарий)

	Запись = РегистрыСведений.СостоянияДокументовЭДО.СоздатьМенеджерЗаписи();
	Запись.ЭлектронныйДокумент = ЭлектронныйДокумент;
	Запись.Прочитать();
	Запись.ЭлектронныйДокумент = ЭлектронныйДокумент;
	Запись.Состояние = Состояние;
	Запись.ДатаИзменения = ТекущаяДатаСеанса();
	Запись.Комментарий = Комментарий;
	Запись.Записать();

КонецПроцедуры

Процедура ЗаписатьОшибкуОператора(ЭлектронныйДокумент, Блокирующая)

	// Ошибка оператора по Т1 в формате ЭПД ({code, blocking, text}) - как ее пишет синхронизация ЭДО.
	Описание = Новый Структура("code, blocking, text", ?(Блокирующая, "EPD-422", "EPD-503"), Блокирующая,
		?(Блокирующая, "Не заполнен КПП грузополучателя: титул не соответствует формату ГИС ЭПД.",
			"Сервис оператора временно недоступен, повторите отправку позже."));
	ЗаписьJSON = Новый ЗаписьJSON;
	ЗаписьJSON.УстановитьСтроку();
	ЗаписатьJSON(ЗаписьJSON, Описание);

	Запись = РегистрыСведений.ОшибкиПередачиЭДО.СоздатьМенеджерЗаписи();
	Запись.ИдентификаторДокументооборота = ЭлектронныйДокумент.ИдентификаторДокументооборота;
	Запись.ИдентификаторОшибки = Строка(Новый УникальныйИдентификатор);
	Запись.КодОшибки = Описание.code;
	Запись.ИдентификаторОтправителя = ЭлектронныйДокумент.ИдентификаторОрганизации;
	Запись.ОписаниеОшибки = ЗаписьJSON.Закрыть();
	Запись.Записать();
	УстановитьСостояниеДокумента(ЭлектронныйДокумент,
		Перечисления.СостоянияДокументовЭДО.ТребуетсяИсправлениеОшибкиПередачи, "");

КонецПроцедуры

Процедура СдвинутьСообщения(ЭлектронныйДокумент, Дней)

	// Сдвигает даты сообщений электронного документа и его состояния на Дней назад: так выглядит перевозка,
	// которая стоит без движения.
	Сдвиг = Окр(Дней * 86400);
	Выборка = Документы.СообщениеЭДО.Выбрать(, , Новый Структура("ЭлектронныйДокумент", ЭлектронныйДокумент));
	Пока Выборка.Следующий() Цикл
		Сообщение = Выборка.ПолучитьОбъект();
		Сообщение.Дата = Сообщение.Дата - Сдвиг;
		Сообщение.ДатаИзмененияСтатуса = Сообщение.ДатаИзмененияСтатуса - Сдвиг;
		Сообщение.ОбменДанными.Загрузка = Истина;
		Сообщение.Записать();
	КонецЦикла;
	Запись = РегистрыСведений.СостоянияДокументовЭДО.СоздатьМенеджерЗаписи();
	Запись.ЭлектронныйДокумент = ЭлектронныйДокумент;
	Запись.Прочитать();
	Если Запись.Выбран() Тогда
		Запись.ДатаИзменения = Запись.ДатаИзменения - Сдвиг;
		Запись.Записать();
	КонецЕсли;

КонецПроцедуры

Процедура СдвинутьДатуЭТрН(ЭТрН, Дней)

	Объект = ЭТрН.ПолучитьОбъект();
	Объект.Дата = Объект.Дата - Окр(Дней * 86400);
	Объект.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

#КонецОбласти

#Область Настройки

Функция ИдентификаторУчастника(Ссылка)

	// Синтетический идентификатор участника ЭДО: оператор 2AE и УИД ссылки без дефисов (символ «_» в имени файла
	// титула - разделитель частей).
	Возврат "2AE-" + ВРег(СтрЗаменить(Строка(Ссылка.УникальныйИдентификатор()), "-", ""));

КонецФункции

Процедура ДобавитьПриглашение(Организация, ИдентификаторОрганизации, Контрагент, ИдентификаторКонтрагента)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Приглашения.Ключ КАК Ключ
	|ИЗ
	|	РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами КАК Приглашения
	|ГДЕ
	|	Приглашения.ИдентификаторОрганизации = &ИдентификаторОрганизации
	|	И Приглашения.ИдентификаторКонтрагента = &ИдентификаторКонтрагента";
	Запрос.УстановитьПараметр("ИдентификаторОрганизации", ИдентификаторОрганизации);
	Запрос.УстановитьПараметр("ИдентификаторКонтрагента", ИдентификаторКонтрагента);
	Если Не Запрос.Выполнить().Пустой() Тогда
		Возврат;
	КонецЕсли;
	Приглашение = РегистрыСведений.ПриглашенияКОбменуЭлектроннымиДокументами.СоздатьМенеджерЗаписи();
	Приглашение.Ключ = Строка(Новый УникальныйИдентификатор);
	Приглашение.ИдентификаторОрганизации = ИдентификаторОрганизации;
	Приглашение.ИдентификаторКонтрагента = ИдентификаторКонтрагента;
	Приглашение.Тип = Перечисления.ТипыПриглашений.НаИдентификатор;
	Приглашение.Статус = Перечисления.СтатусыПриглашений.Принято;
	Приглашение.ДатаИзмененияСтатуса = ТекущаяДатаСеанса();
	Приглашение.Организация = Организация;
	Приглашение.Контрагент = Контрагент;
	Приглашение.Наименование = Строка(Контрагент);
	Приглашение.Записать();

КонецПроцедуры

Функция ПеревозчикПоУмолчанию()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Контрагенты.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.Контрагенты КАК Контрагенты
	|ГДЕ
	|	НЕ Контрагенты.ПометкаУдаления
	|	И Контрагенты.ИНН <> """"
	|	И Контрагенты.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Контрагенты.Наименование";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	Возврат Выборка.Ссылка;

КонецФункции

#КонецОбласти

#Область Удаление

Процедура УдалитьЭлектронныйДокумент(ЭлектронныйДокумент, ИдентификаторДокументооборота)

	Выборка = Документы.СообщениеЭДО.Выбрать(, , Новый Структура("ЭлектронныйДокумент", ЭлектронныйДокумент));
	Пока Выборка.Следующий() Цикл
		Файлы = Справочники.СообщениеЭДОПрисоединенныеФайлы.Выбрать(, ,
			Новый Структура("ВладелецФайла", Выборка.Ссылка));
		Пока Файлы.Следующий() Цикл
			УдалитьЗаписиПоОтбору("СведенияОФайлахСообщенийЭДО", "ФайлСообщенияЭДО", Файлы.Ссылка, Ложь);
			Файл = Файлы.ПолучитьОбъект();
			Файл.ОбменДанными.Загрузка = Истина;
			Файл.Удалить();
		КонецЦикла;
		Сообщение = Выборка.ПолучитьОбъект();
		Сообщение.ОбменДанными.Загрузка = Истина;
		Сообщение.Удалить();
	КонецЦикла;
	УдалитьЗаписиПоОтбору("СостоянияДокументовЭДО", "ЭлектронныйДокумент", ЭлектронныйДокумент);
	УдалитьЗаписиПоОтбору("ЖурналДействийПоЭДО", "ЭлектронныйДокумент", ЭлектронныйДокумент);
	Если ЗначениеЗаполнено(ИдентификаторДокументооборота) Тогда
		УдалитьЗаписиПоОтбору("ОшибкиПередачиЭДО", "ИдентификаторДокументооборота", ИдентификаторДокументооборота);
	КонецЕсли;
	Объект = ЭлектронныйДокумент.ПолучитьОбъект();
	Если Объект <> Неопределено Тогда
		Объект.ОбменДанными.Загрузка = Истина;
		Объект.Удалить();
	КонецЕсли;

КонецПроцедуры

Процедура УдалитьЗаписиПоОтбору(ИмяРегистра, Поле, Значение, ЭтоИзмерение = Истина)

	// Удаляет записи регистра сведений по отбору. Отбор по реквизиту (не измерению) - через запрос измерений.
	МетаданныеРегистра = Метаданные.РегистрыСведений[ИмяРегистра];
	Если ЭтоИзмерение И МетаданныеРегистра.Измерения.Найти(Поле) <> Неопределено Тогда
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Набор.Отбор[Поле].Установить(Значение);
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
		Возврат;
	КонецЕсли;
	Измерения = Новый Массив;
	Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
		Измерения.Добавить("ЗаписиРегистра." + Измерение.Имя + " КАК " + Измерение.Имя);
	КонецЦикла;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	&Измерения
	|ИЗ
	|	&ТаблицаРегистра КАК ЗаписиРегистра
	|ГДЕ
	|	ЗаписиРегистра.&ПолеОтбора = &Значение";
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&Измерения", СтрСоединить(Измерения, ", "));
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ТаблицаРегистра", "РегистрСведений." + ИмяРегистра);
	Запрос.Текст = СтрЗаменить(Запрос.Текст, "&ПолеОтбора", Поле);
	Запрос.УстановитьПараметр("Значение", Значение);
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Набор = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
		Для Каждого Измерение Из МетаданныеРегистра.Измерения Цикл
			Набор.Отбор[Измерение.Имя].Установить(Выборка[Измерение.Имя]);
		КонецЦикла;
		Набор.ОбменДанными.Загрузка = Истина;
		Набор.Записать();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

Функция РеализацииДляНаполнения(Количество)

	// Проведенные реализации с адресом доставки без ЭТрН, новые первыми. Покупатель - юрлицо: для физлица БЭД
	// требует в титуле других сведений о грузополучателе.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 50
	|	Реализации.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Реализации.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяТранспортнаяНакладная.ДокументыОснования КАК Основания
	|		ПО Реализации.Ссылка = Основания.ДокументОснование
	|ГДЕ
	|	Реализации.Проведен
	|	И Реализации.АдресДоставки <> """"
	|	И Контрагенты.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|	И Основания.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реализации.Дата УБЫВ";
	Реализации = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	Если Реализации.Количество() < Количество Тогда
		ВызватьИсключение СтрШаблон("На стенде меньше %1 реализаций с адресом доставки без ЭТрН", Количество);
	КонецЕсли;
	Возврат Реализации;

КонецФункции

