// Тесты детерминированной диагностики ЭТрН: код, чей ход, дни и действие по состоянию
// документооборота. Состояния собираются в памяти, данных базы тесты не читают.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Наш ход")
		.ДобавитьТест("БезТитулаГрузоотправителяНужноОформить")
		.ДобавитьТест("НеподписанныйТитулПодписываетПользователь")
		.ДобавитьТест("ПодписанныйНеотправленныйТитулОтправляетсяПовторно")
		.ДобавитьТест("ВременнаяОшибкаОператораДаетПовторнуюОтправку")
		.ДобавитьТест("БлокирующаяОшибкаОператораТребуетИсправления")
		.ДобавитьТест("ОтказПеревозчикаСПричиной")
		.ДобавитьТестовыйНабор("Ход контрагента")
		.ДобавитьТест("ПослеОтправкиЖдемПеревозчика")
		.ДобавитьТест("ПослеПриемаЖдемГрузополучателя")
		.ДобавитьТест("ПослеПриемкиЖдемВыдачи")
		.ДобавитьТест("СтарыйОтказПередНовымТитуломНеСчитается")
		.ДобавитьТестовыйНабор("Завершение")
		.ДобавитьТест("ТитулВыдачиЗакрываетПеревозку")
		.ДобавитьТест("ПометкаУдаленияВажнееСостояния")
		.ДобавитьТестовыйНабор("Группы состояний")
		.ДобавитьТест("ГруппыПоКорнюИмени");

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура БезТитулаГрузоотправителяНужноОформить() Экспорт

	Диагноз = Диагноз(Состояние());
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("T1_NOT_FORMED");
	ЮТест.ОжидаетЧто(Диагноз.ЧейХод).Равно("us");
	ЮТест.ОжидаетЧто(Диагноз.Действие).Равно("open");
	ЮТест.ОжидаетЧто(Диагноз.Дней).Равно(10);

КонецПроцедуры

Процедура НеподписанныйТитулПодписываетПользователь() Экспорт

	Состояние = Состояние("ТребуетсяПодписание");
	ДобавитьТитул(Состояние, "Т1", Ложь, "Сформирован", 9);
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("T1_NOT_SIGNED");
	ЮТест.ОжидаетЧто(Диагноз.Действие).Равно("open");

КонецПроцедуры

Процедура ПодписанныйНеотправленныйТитулОтправляетсяПовторно() Экспорт

	Состояние = Состояние("ТребуетсяОтправка");
	ДобавитьТитул(Состояние, "Т1", Ложь, "ПодготовленКОтправке", 3);
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("T1_NOT_SENT");

	// Обмен без подписи: сообщение «Сформирован», документ ждет подготовки к отправке.
	Состояние = Состояние("ТребуетсяПодготовкаКОтправке");
	ДобавитьТитул(Состояние, "Т1", Ложь, "Сформирован", 3);
	ЮТест.ОжидаетЧто(Диагноз(Состояние).Код).Равно("T1_NOT_SENT");
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Титул).Равно("Т1");
	ЮТест.ОжидаетЧто(Диагноз.ЧейХод).Равно("us");
	ЮТест.ОжидаетЧто(Диагноз.Действие).Равно("epd_send");
	ЮТест.ОжидаетЧто(Диагноз.Дней).Равно(3);

КонецПроцедуры

Процедура ВременнаяОшибкаОператораДаетПовторнуюОтправку() Экспорт

	Состояние = Состояние("ТребуетсяИсправлениеОшибкиПередачи");
	ДобавитьТитул(Состояние, "Т1", Ложь, "Отправлен", 2);
	Состояние.ОшибкаОператора = Новый Структура("Код, Текст, Блокирующая", "EPD-503", "Сервис недоступен", Ложь);
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("T1_ERROR");
	ЮТест.ОжидаетЧто(Диагноз.Причина).Равно("Сервис недоступен");
	ЮТест.ОжидаетЧто(Диагноз.Действие).Равно("epd_send");

КонецПроцедуры

Процедура БлокирующаяОшибкаОператораТребуетИсправления() Экспорт

	Состояние = Состояние("ОжидаетсяПодтверждение");
	ДобавитьТитул(Состояние, "Т1", Ложь, "Отправлен", 2);
	Состояние.ОшибкаОператора = Новый Структура("Код, Текст, Блокирующая", "EPD-422", "Не заполнен КПП", Истина);
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("T1_ERROR");
	ЮТест.ОжидаетЧто(Диагноз.Действие).Равно("open");

КонецПроцедуры

Процедура ОтказПеревозчикаСПричиной() Экспорт

	Состояние = Состояние("ЗакрытСОтклонением");
	Состояние.Комментарий = "Машина не подана";
	ДобавитьТитул(Состояние, "Т1", Ложь, "Отправлен", 5);
	ДобавитьТитул(Состояние, "ОткП", Истина, "Получен", 4);
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("T1_REJECTED");
	ЮТест.ОжидаетЧто(Диагноз.Причина).Равно("Машина не подана");
	ЮТест.ОжидаетЧто(Диагноз.Действие).Равно("open");
	ЮТест.ОжидаетЧто(Диагноз.Дней).Равно(4);

КонецПроцедуры

Процедура ПослеОтправкиЖдемПеревозчика() Экспорт

	Состояние = Состояние("ОжидаетсяПодтверждение");
	ДобавитьТитул(Состояние, "Т1", Ложь, "Отправлен", 6);
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("WAIT_T2");
	ЮТест.ОжидаетЧто(Диагноз.ЧейХод).Равно("carrier");
	ЮТест.ОжидаетЧто(Диагноз.Контрагент).Равно("перевозчик");
	ЮТест.ОжидаетЧто(Диагноз.Действие).Равно("wait");
	ЮТест.ОжидаетЧто(Диагноз.Дней).Равно(6);

КонецПроцедуры

Процедура ПослеПриемаЖдемГрузополучателя() Экспорт

	Состояние = Состояние("ОжидаетсяПодтверждение");
	ДобавитьТитул(Состояние, "Т1", Ложь, "Отправлен", 6);
	ДобавитьТитул(Состояние, "Т2", Истина, "Получен", 5);
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("WAIT_T3");
	ЮТест.ОжидаетЧто(Диагноз.ЧейХод).Равно("consignee");
	ЮТест.ОжидаетЧто(Диагноз.Контрагент).Равно("грузополучатель");
	ЮТест.ОжидаетЧто(Диагноз.Дней).Равно(5);

КонецПроцедуры

Процедура ПослеПриемкиЖдемВыдачи() Экспорт

	Состояние = Состояние("ОжидаетсяПодтверждение");
	ДобавитьТитул(Состояние, "Т1", Ложь, "Отправлен", 6);
	ДобавитьТитул(Состояние, "Т2", Истина, "Получен", 5);
	ДобавитьТитул(Состояние, "Т3", Истина, "Получен", 1);
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("WAIT_T4");
	ЮТест.ОжидаетЧто(Диагноз.ЧейХод).Равно("carrier");
	ЮТест.ОжидаетЧто(Диагноз.Дней).Равно(1);

КонецПроцедуры

Процедура СтарыйОтказПередНовымТитуломНеСчитается() Экспорт

	Состояние = Состояние("ОжидаетсяПодтверждение");
	ДобавитьТитул(Состояние, "ОткП", Истина, "Получен", 8);
	ДобавитьТитул(Состояние, "Т1", Ложь, "Отправлен", 2);
	ЮТест.ОжидаетЧто(Диагноз(Состояние).Код).Равно("WAIT_T2");

КонецПроцедуры

Процедура ТитулВыдачиЗакрываетПеревозку() Экспорт

	Состояние = Состояние("ОбменЗавершен");
	ДобавитьТитул(Состояние, "Т1", Ложь, "Отправлен", 6);
	ДобавитьТитул(Состояние, "Т2", Истина, "Получен", 5);
	ДобавитьТитул(Состояние, "Т3", Истина, "Получен", 2);
	ДобавитьТитул(Состояние, "Т4", Истина, "Получен", 1);
	Диагноз = Диагноз(Состояние);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("DONE");
	ЮТест.ОжидаетЧто(Диагноз.Действие).Равно("none");

КонецПроцедуры

Процедура ПометкаУдаленияВажнееСостояния() Экспорт

	Состояние = Состояние("ТребуетсяОтправка");
	ДобавитьТитул(Состояние, "Т1", Ложь, "ПодготовленКОтправке", 3);
	Состояние.ПометкаУдаления = Истина;
	ЮТест.ОжидаетЧто(Диагноз(Состояние).Код).Равно("DELETED");

КонецПроцедуры

Процедура ГруппыПоКорнюИмени() Экспорт

	Ожидания = Новый Соответствие;
	Ожидания.Вставить("ТребуетсяПодписание", "our_sign");
	Ожидания.Вставить("ТребуетсяОтправка", "our_send");
	Ожидания.Вставить("ТребуетсяПодготовкаКОтправке", "our_send");
	Ожидания.Вставить("ТребуетсяИсправлениеОшибкиПередачи", "transfer_error");
	Ожидания.Вставить("ЗакрытСОшибкойПередачи", "transfer_error");
	Ожидания.Вставить("ЗакрытСОтклонением", "rejected");
	Ожидания.Вставить("ОжидаетсяИсправление", "rejected");
	Ожидания.Вставить("Аннулирован", "annulled");
	Ожидания.Вставить("ОжидаетсяПодтверждение", "waiting");
	Ожидания.Вставить("ОбменЗавершенСИсправлением", "done");
	Ожидания.Вставить("НеСформирован", "not_started");
	Ожидания.Вставить("", "not_started");
	Ожидания.Вставить("УдалитьОжидаетсяИзвещение", "other");
	Для Каждого КлючИЗначение Из Ожидания Цикл
		ЮТест.ОжидаетЧто(ИИОЭ_Диагностика.ГруппаСостояния(КлючИЗначение.Ключ), КлючИЗначение.Ключ)
			.Равно(КлючИЗначение.Значение);
	КонецЦикла;

	// Все значения перечисления БЭД попадают в какую-то группу без исключений.
	Для Каждого Значение Из Метаданные.Перечисления.СостоянияДокументовЭДО.ЗначенияПеречисления Цикл
		ЮТест.ОжидаетЧто(ИИОЭ_Диагностика.ГруппаСостояния(Значение.Имя), Значение.Имя).Заполнено();
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Сегодня()

	Возврат Дата(2026, 10, 4, 15, 0, 0);

КонецФункции

Функция Состояние(СостояниеЭДО = "")

	Состояние = ИИОЭ_БЭД.НовоеСостояние();
	Состояние.Дата = Сегодня() - 10 * 86400;
	Состояние.Перевозчик = "перевозчик";
	Состояние.Грузополучатель = "грузополучатель";
	Состояние.СостояниеЭДО = СостояниеЭДО;
	Состояние.ЕстьЭлектронныйДокумент = ЗначениеЗаполнено(СостояниеЭДО);
	Возврат Состояние;

КонецФункции

Процедура ДобавитьТитул(Состояние, Титул, Входящий, Статус, ДнейНазад)

	Состояние.Титулы.Вставить(Титул, Новый Структура("Входящий, Статус, Дата", Входящий, Статус,
		Сегодня() - ДнейНазад * 86400));

КонецПроцедуры

Функция Диагноз(Состояние)

	Возврат ИИОЭ_Диагностика.Диагноз(Состояние, Сегодня());

КонецФункции

#КонецОбласти
