Процедура ОтметкаОтправкиПереводитВОжиданиеПеревозчика() Экспорт

	ЭТрН = ОМ_ИИОЭ_ГенераторЭТрН.СоздатьЭТрН(Реализация(), "T1_ERROR");
	ЮТест.ОжидаетЧто(Диагноз(ЭТрН).Код).Равно("T1_ERROR");
	ИИОЭ_Транспорт.ОтметитьОтправкуТитула(ЭТрН.ПолучитьОбъект());
	Диагноз = Диагноз(ЭТрН);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("WAIT_T2");
	ЮТест.ОжидаетЧто(Диагноз.Дней).Равно(0);
	Состояние = ИИОЭ_БЭД.СостоянияЭТрН(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЭТрН)).Получить(ЭТрН);
	ЮТест.ОжидаетЧто(Состояние.ОшибкаОператора).Равно(Неопределено);
	ЮТест.ОжидаетЧто(Состояние.СостояниеЭДО).Равно("ОжидаетсяПодтверждение");

КонецПроцедуры

Процедура ОтказВнешнегоШагаНеМеняетЭТрН() Экспорт

	// Тестовый сервер оператора не задан: внешний шаг отказывает до транзакции, отметка в БЭД не выполняется.
	РазрешитьОтправку();
	Константы.ИИОЭ_АдресТестовогоСервераОператораЭДО.Установить("");
	ЭТрН = ОМ_ИИОЭ_ГенераторЭТрН.СоздатьЭТрН(Реализация(), "T1_NOT_SENT");
	Ссылки = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ИИО_Ответ.СсылкаВСтроку(ЭТрН));
	Подготовленный = ИИО_Действия.ПодготовитьДействие(
		Новый Структура("action, refs, dry_run", "epd_send", Ссылки, Ложь), "test");
	Предпросмотр = ИИО_Действия.ОткрытьПредпросмотр(Подготовленный.АдресПлана, Новый УникальныйИдентификатор);
	ИИО_Действия.ВыполнитьПорцию(Предпросмотр.АдресПлана, Предпросмотр.Ключ, 0, 100);
	Ответ = ИИО_Действия.ЗавершитьПакет(Предпросмотр.АдресПлана, Предпросмотр.Ключ);

	ЮТест.ОжидаетЧто(Ответ.done).ИмеетДлину(0);
	ЮТест.ОжидаетЧто(Ответ.failed).ИмеетДлину(1);
	ЮТест.ОжидаетЧто(Ответ.failed[0].error).Содержит("Отправить через ЭДО");
	ЮТест.ОжидаетЧто(Ответ.failed[0].error).НеСодержит("Внешняя часть действия выполнена");
	ЮТест.ОжидаетЧто(Диагноз(ЭТрН).Код).Равно("T1_NOT_SENT");

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция Диагноз(ЭТрН)

	Состояние = ИИОЭ_БЭД.СостоянияЭТрН(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЭТрН)).Получить(ЭТрН);
	Возврат ИИОЭ_Диагностика.Диагноз(Состояние, ТекущаяДатаСеанса());

КонецФункции

Функция Реализация()

	// Реализация, по которой генератор создает ЭТрН: проведена, есть адрес доставки, покупатель - юрлицо
	// (для физлица БЭД требует других сведений о грузополучателе), своей ЭТрН еще нет.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Реализации.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.Контрагенты КАК Контрагенты
	|		ПО Реализации.Контрагент = Контрагенты.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяТранспортнаяНакладная.ДокументыОснования КАК Основания
	|		ПО Реализации.Ссылка = Основания.ДокументОснование
	|ГДЕ
	|	Реализации.Проведен
	|	И Реализации.АдресДоставки <> """"
	|	И Контрагенты.ЮрФизЛицо = ЗНАЧЕНИЕ(Перечисление.ЮрФизЛицо.ЮрЛицо)
	|	И Основания.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Реализации.Дата УБЫВ";
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Реализация с адресом доставки без ЭТрН в базе").ЭтоИстина();
	Возврат Выборка.Ссылка;

КонецФункции

Функция РеализацияБезЭТрН()

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Реализации.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.РеализацияТоваровУслуг КАК Реализации
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяТранспортнаяНакладная.ДокументыОснования КАК Основания
	|		ПО Реализации.Ссылка = Основания.ДокументОснование
	|ГДЕ
	|	Реализации.Проведен
	|	И Основания.Ссылка ЕСТЬ NULL";
	Выборка = Запрос.Выполнить().Выбрать();
	ЮТест.ОжидаетЧто(Выборка.Следующий(), "Реализация без ЭТрН на стенде").ЭтоИстина();
	Возврат Выборка.Ссылка;

КонецФункции

Процедура РазрешитьОтправку()

	// Разрешение epd_send для текущего пользователя в регистре разрешений ИИ-оператора (тест в транзакции).
	Запись = РегистрыСведений.ИИО_РазрешенияДействий.СоздатьМенеджерЗаписи();
	Запись.Действие = "epd_send";
	Запись.Пользователь = Пользователи.АвторизованныйПользователь();
	Запись.Разрешено = Истина;
	Запись.Записать();

КонецПроцедуры

#КонецОбласти
