КонецПроцедуры

Процедура ДействиеЗарегистрированоВЯдре() Экспорт

	Описание = ИИО_Действия.Действия().Получить("epd_send");
	ЮТест.ОжидаетЧто(Описание).Заполнено();
	ЮТест.ОжидаетЧто(Описание.Обработчик).Равно("ИИОЭ_ДействияЭПД");
	ЮТест.ОжидаетЧто(ИИО_Права.РазрешаемыеДействия().Получить("epd_send")).Заполнено();

	// Схема perform для модели знает код действия пакета.
	Схема = Неопределено;
	Для Каждого Определение Из ИИО_ИнструментыКлиентСервер.Определения(ИИО_Действия.ДействияПакетов()) Цикл
		Если Определение.Имя = "perform" Тогда
			Схема = Определение.Схема;
		КонецЕсли;
	КонецЦикла;
	ЮТест.ОжидаетЧто(Схема.properties.action.enum).Содержит("epd_send").Содержит("post");

КонецПроцедуры

