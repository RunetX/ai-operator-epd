// Тесты пакета ЭТрН на объектах БЭД: генератор создает ЭТрН штатными вызовами БЭД, адаптер читает
// состояние, диагностика и epd_status дают код и действие. Каждый тест - в транзакции: данные стенда не меняются.

#Область СлужебныйПрограммныйИнтерфейс

Процедура ИсполняемыеСценарии() Экспорт

	ЮТТесты
		.ДобавитьТестовыйНабор("Состояния по объектам БЭД")
		.ДобавитьТест("КаждоеСостояниеГенератораДиагностируется").ВТранзакции()
		.ДобавитьТест("ОшибкаОператораЧитаетсяИзРегистра").ВТранзакции()
		.ДобавитьТест("ОтказПеревозчикаСКомментарием").ВТранзакции()
		.ДобавитьТестовыйНабор("Инструмент epd_status")
		.ДобавитьТест("СтатусПоРеализацииНаходитЭТрН").ВТранзакции()
		.ДобавитьТест("РеализацияБезЭТрНДаетNO_ETRN").ВТранзакции()
		.ДобавитьТест("ВБотеКнопкиОткрытьИПредпросмотр").ВТранзакции()
		.ДобавитьТест("ВодительУходитВКонтекстПДн").ВТранзакции()
		.ДобавитьТест("ЧужойОбъектНеПринимается")
		.ДобавитьТестовыйНабор("Действие epd_send")
		.ДобавитьТест("ДействиеЗарегистрированоВЯдре")
		.ДобавитьТест("ПланДействияТолькоДляНеотправленного").ВТранзакции()
		.ДобавитьТест("БезМокаОтправкаНевозможна").ВТранзакции()
		.ДобавитьТест("ОтметкаОтправкиПереводитВОжиданиеПеревозчика").ВТранзакции()
		.ДобавитьТест("ОтказВнешнегоШагаНеМеняетЭТрН").ВТранзакции();

КонецПроцедуры

#КонецОбласти

#Область Тесты

Процедура КаждоеСостояниеГенератораДиагностируется() Экспорт

	Ожидания = Новый Соответствие;
	Ожидания.Вставить("T1_NOT_FORMED", "T1_NOT_FORMED");
	Ожидания.Вставить("T1_NOT_SENT", "T1_NOT_SENT");
	Ожидания.Вставить("T1_ERROR", "T1_ERROR");
	Ожидания.Вставить("T1_ERROR_BLOCKING", "T1_ERROR");
	Ожидания.Вставить("T1_REJECTED", "T1_REJECTED");
	Ожидания.Вставить("WAIT_T2", "WAIT_T2");
	Ожидания.Вставить("WAIT_T3", "WAIT_T3");
	Ожидания.Вставить("WAIT_T4", "WAIT_T4");
	Ожидания.Вставить("DONE", "DONE");
	Реализация = Реализация();
	Параметры = ОМ_ИИОЭ_ГенераторЭТрН.НовыеПараметры();
	Параметры.ДнейНазад = 5;
	Для Каждого Состояние Из ОМ_ИИОЭ_ГенераторЭТрН.Состояния() Цикл
		ЭТрН = ОМ_ИИОЭ_ГенераторЭТрН.СоздатьЭТрН(Реализация, Состояние, Параметры);
		Диагноз = Диагноз(ЭТрН);
		ЮТест.ОжидаетЧто(Диагноз.Код, Состояние).Равно(Ожидания.Получить(Состояние));
		Если Состояние <> "DONE" Тогда
			ЮТест.ОжидаетЧто(Диагноз.Дней, Состояние + ": дни без движения").Равно(5);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

Процедура ОшибкаОператораЧитаетсяИзРегистра() Экспорт

	ЭТрН = ОМ_ИИОЭ_ГенераторЭТрН.СоздатьЭТрН(Реализация(), "T1_ERROR");
	Состояние = ИИОЭ_БЭД.СостоянияЭТрН(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(ЭТрН)).Получить(ЭТрН);
	ЮТест.ОжидаетЧто(Состояние.ОшибкаОператора).ИмеетТип("Структура");
	ЮТест.ОжидаетЧто(Состояние.ОшибкаОператора.Код).Равно("EPD-503");
	ЮТест.ОжидаетЧто(Состояние.ОшибкаОператора.Блокирующая).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Состояние.ОшибкаОператора.Текст).Содержит("временно недоступен");
	ЮТест.ОжидаетЧто(Диагноз(ЭТрН).Действие).Равно("epd_send");

	ЭТрН = ОМ_ИИОЭ_ГенераторЭТрН.СоздатьЭТрН(Реализация(), "T1_ERROR_BLOCKING");
	ЮТест.ОжидаетЧто(Диагноз(ЭТрН).Действие).Равно("open");

КонецПроцедуры

Процедура ОтказПеревозчикаСКомментарием() Экспорт

	Параметры = ОМ_ИИОЭ_ГенераторЭТрН.НовыеПараметры();
	Параметры.ПричинаОтказа = "Машина сломалась";
	ЭТрН = ОМ_ИИОЭ_ГенераторЭТрН.СоздатьЭТрН(Реализация(), "T1_REJECTED", Параметры);
	Диагноз = Диагноз(ЭТрН);
	ЮТест.ОжидаетЧто(Диагноз.Код).Равно("T1_REJECTED");
	ЮТест.ОжидаетЧто(Диагноз.Причина).Равно("Машина сломалась");

КонецПроцедуры

Процедура СтатусПоРеализацииНаходитЭТрН() Экспорт

	Реализация = Реализация();
	ЭТрН = ОМ_ИИОЭ_ГенераторЭТрН.СоздатьЭТрН(Реализация, "WAIT_T3");
	Ответ = ИИОЭ_СтатусЭПД.Статус(Новый Структура("ref", ИИО_Ответ.СсылкаВСтроку(Реализация)));
	ЮТест.ОжидаетЧто(Ответ.Свойство("error")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Ответ.etrn.Количество()).БольшеИлиРавно(1);
	Элемент = Ответ.etrn[0];
	ЮТест.ОжидаетЧто(Элемент.etrn.ref).Равно(ИИО_Ответ.СсылкаВСтроку(ЭТрН));
	ЮТест.ОжидаетЧто(Элемент.diagnosis.code).Равно("WAIT_T3");
	ЮТест.ОжидаетЧто(Элемент.diagnosis.whose_turn).Равно("consignee");
	ЮТест.ОжидаетЧто(Элемент.diagnosis.text).Заполнено();
	ЮТест.ОжидаетЧто(Элемент.titles[1].status).Равно("received");
	ЮТест.ОжидаетЧто(Элемент.titles[2].status).Равно("none");

КонецПроцедуры

Процедура РеализацияБезЭТрНДаетNO_ETRN() Экспорт

	Ответ = ИИОЭ_СтатусЭПД.Статус(Новый Структура("ref", ИИО_Ответ.СсылкаВСтроку(РеализацияБезЭТрН())));
