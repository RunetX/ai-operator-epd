	ЮТест.ОжидаетЧто(Ответ.etrn.Количество()).Равно(0);
	ЮТест.ОжидаетЧто(Ответ.diagnosis.code).Равно("NO_ETRN");

КонецПроцедуры

Процедура ВБотеКнопкиОткрытьИПредпросмотр() Экспорт

	РазрешитьОтправку();
	ЭТрН = ОМ_ИИОЭ_ГенераторЭТрН.СоздатьЭТрН(Реализация(), "T1_NOT_SENT");
	Кнопки = Новый Массив;
	Ответ = ИИОЭ_СтатусЭПД.Статус(Новый Структура("ref", ИИО_Ответ.СсылкаВСтроку(ЭТрН)), Кнопки);
	ЮТест.ОжидаетЧто(Ответ.actions[0].action).Равно("epd_send");
	Инструменты = Новый Массив;
	Для Каждого Кнопка Из Кнопки Цикл
		Инструменты.Добавить(Кнопка.Инструмент);
	КонецЦикла;
	ЮТест.ОжидаетЧто(Инструменты).Содержит("open_object").Содержит("perform");

	// Ждем перевозчика - предпросмотра нет, только «Открыть ЭТрН».
	ЭТрН = ОМ_ИИОЭ_ГенераторЭТрН.СоздатьЭТрН(Реализация(), "WAIT_T2");
	Кнопки = Новый Массив;
	Ответ = ИИОЭ_СтатусЭПД.Статус(Новый Структура("ref", ИИО_Ответ.СсылкаВСтроку(ЭТрН)), Кнопки);
	ЮТест.ОжидаетЧто(Ответ.Свойство("actions")).ЭтоЛожь();
	ЮТест.ОжидаетЧто(Кнопки.Количество()).Равно(1);
	ЮТест.ОжидаетЧто(Кнопки[0].Инструмент).Равно("open_object");

КонецПроцедуры

Процедура ВодительУходитВКонтекстПДн() Экспорт

