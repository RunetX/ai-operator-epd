// Детерминированная диагностика исходящей ЭТрН грузоотправителя: по состоянию документооборота
// (см. ИИОЭ_БЭД.СостоянияЭТрН) - код, на каком титуле стоит перевозка, чей ход и одно действие.
// Модель только пересказывает диагноз: вывод делает код, а не она.
//
// Коды:
//  DELETED - ЭТрН помечена на удаление;
//  T1_NOT_FORMED - титул грузоотправителя не сформирован;
//  T1_NOT_SIGNED - Т1 сформирован, но не подписан;
//  T1_NOT_SENT - Т1 подписан, но не отправлен оператору;
//  T1_ERROR - оператор вернул ошибку по Т1;
//  T1_REJECTED - перевозчик отказался принять груз к перевозке (ОткП);
//  T3_REJECTED - грузополучатель принял груз с замечаниями или отказался (ОткТ3);
//  WAIT_T2, WAIT_T3, WAIT_T4 - ждем титул перевозчика, грузополучателя, снова перевозчика;
//  DONE - перевозка закрыта: получен Т4;
//  OTHER - состояние, которое пакет не разбирает (аннулирование, входящая ЭТрН).

#Область ПрограммныйИнтерфейс

// Диагноз по состоянию ЭТрН.
//
// Параметры:
//  Состояние - см. ИИОЭ_БЭД.НовоеСостояние
//  ТекущаяДата - Дата - Дата, от которой считаются дни ожидания.
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - См. описание модуля.
//   * Титул - Строка - На каком титуле стоит перевозка: Т1, Т2, Т3, Т4 или пустая строка.
//   * ЧейХод - Строка - us (грузоотправитель), carrier, consignee, none.
//   * Контрагент - СправочникСсылка.Контрагенты, Произвольный - Чьего действия ждем.
//   * Дней - Число - Сколько дней с последнего события по перевозке.
//   * С - Дата - Дата последнего события.
//   * Причина - Строка - Текст ошибки оператора или причина отказа.
//   * Действие - Строка - epd_send (повторить отправку через предпросмотр), open (сделать в форме ЭТрН),
//     wait (ждать контрагента), none.
Функция Диагноз(Состояние, ТекущаяДата) Экспорт

	Диагноз = НовыйДиагноз(Состояние);
	Группа = ГруппаСостояния(Состояние.СостояниеЭДО);
	Т1 = Состояние.Титулы.Получить("Т1");
	Т2 = Состояние.Титулы.Получить("Т2");
	Т3 = Состояние.Титулы.Получить("Т3");
	Т4 = Состояние.Титулы.Получить("Т4");

	Если Состояние.ПометкаУдаления Тогда
		Возврат Установить(Диагноз, "DELETED", "", "none", "none");
	ИначеЕсли Состояние.ЭтоВходящий Тогда
		Возврат Установить(Диагноз, "OTHER", "", "none", "none");
	ИначеЕсли Т4 <> Неопределено И Т4.Входящий Или Группа = "done" Тогда
		Диагноз = Установить(Диагноз, "DONE", "Т4", "none", "none");
		Возврат УстановитьСрок(Диагноз, ?(Т4 = Неопределено, Состояние.ДатаСостояния, Т4.Дата), ТекущаяДата);
	КонецЕсли;

	Отказ = ПоследнийОтказ(Состояние);
	Если Отказ = "ОткП" Тогда
		Диагноз = Установить(Диагноз, "T1_REJECTED", "Т1", "us", "open");
		Диагноз.Причина = Состояние.Комментарий;
		Возврат УстановитьСрок(Диагноз, Состояние.Титулы.Получить(Отказ).Дата, ТекущаяДата);
	ИначеЕсли Отказ = "ОткТ3" Тогда
		Диагноз = Установить(Диагноз, "T3_REJECTED", "Т3", "us", "open");
		Диагноз.Причина = Состояние.Комментарий;
		Возврат УстановитьСрок(Диагноз, Состояние.Титулы.Получить(Отказ).Дата, ТекущаяДата);
	КонецЕсли;

	Если Т1 = Неопределено Или Т1.Входящий Тогда
		Если Группа = "annulled" Тогда
			Возврат Установить(Диагноз, "OTHER", "", "none", "none");
		КонецЕсли;
		Диагноз = Установить(Диагноз, "T1_NOT_FORMED", "Т1", "us", "open");
		Возврат УстановитьСрок(Диагноз, Состояние.Дата, ТекущаяДата);
	КонецЕсли;

	Если Состояние.ОшибкаОператора <> Неопределено Или Группа = "transfer_error" Тогда
		Диагноз = Установить(Диагноз, "T1_ERROR", "Т1", "us", "epd_send");
		Если Состояние.ОшибкаОператора <> Неопределено Тогда
			Диагноз.Причина = Состояние.ОшибкаОператора.Текст;
			Если Состояние.ОшибкаОператора.Блокирующая Тогда
				Диагноз.Действие = "open";
			КонецЕсли;
		КонецЕсли;
		Возврат УстановитьСрок(Диагноз, Т1.Дата, ТекущаяДата);
	КонецЕсли;

	Если Не СообщениеОтправлено(Т1) Тогда
		// При обмене без подписи сформированный Т1 сразу ждет отправки: статус сообщения «Сформирован»,
		// а состояние документа - «Требуется подготовка к отправке».
		Если Группа <> "our_send" И (Т1.Статус = "Сформирован" Или Группа = "our_sign") Тогда
			Диагноз = Установить(Диагноз, "T1_NOT_SIGNED", "Т1", "us", "open");
		Иначе
			Диагноз = Установить(Диагноз, "T1_NOT_SENT", "Т1", "us", "epd_send");
		КонецЕсли;
		Возврат УстановитьСрок(Диагноз, Т1.Дата, ТекущаяДата);
	КонецЕсли;

	Если Группа = "annulled" Тогда
		Возврат Установить(Диагноз, "OTHER", "", "none", "none");
	ИначеЕсли Т2 = Неопределено Тогда
		Диагноз = Установить(Диагноз, "WAIT_T2", "Т2", "carrier", "wait");
		Возврат УстановитьСрок(Диагноз, Т1.Дата, ТекущаяДата);
	ИначеЕсли Т3 = Неопределено Тогда
		Диагноз = Установить(Диагноз, "WAIT_T3", "Т3", "consignee", "wait");
		Возврат УстановитьСрок(Диагноз, Т2.Дата, ТекущаяДата);
	КонецЕсли;
	Диагноз = Установить(Диагноз, "WAIT_T4", "Т4", "carrier", "wait");
	Возврат УстановитьСрок(Диагноз, Т3.Дата, ТекущаяДата);

КонецФункции

// Группа состояния электронного документа по корню имени значения СостоянияДокументовЭДО: значения
// между релизами БЭД переименовываются и добавляются, поэтому полный список не сверяется.
//
// Параметры:
//  ИмяСостояния - Строка - Имя значения перечисления СостоянияДокументовЭДО.
//
// Возвращаемое значение:
//  Строка - our_sign, our_send, transfer_error, rejected, annulled, waiting, done, not_started, other.
Функция ГруппаСостояния(ИмяСостояния) Экспорт

	Имя = НРег(ИмяСостояния);
	Если Не ЗначениеЗаполнено(Имя) Или Имя = "несформирован" Тогда
		Возврат "not_started";
	ИначеЕсли СтрНачинаетсяС(Имя, "удалить") Тогда
		Возврат "other";
	ИначеЕсли СтрНайти(Имя, "ошибк") > 0 Тогда
		Возврат "transfer_error";
	ИначеЕсли СтрНайти(Имя, "аннулир") > 0 Или СтрНайти(Имя, "отзыв") > 0 Тогда
		Возврат "annulled";
	ИначеЕсли СтрНачинаетсяС(Имя, "обмензавершен") Тогда
		Возврат "done";
	ИначеЕсли СтрНайти(Имя, "отклонен") > 0 Или СтрНайти(Имя, "исправлени") > 0 Или СтрНайти(Имя, "уточнени") > 0
		Или СтрНайти(Имя, "отказ") > 0 Тогда
		Возврат "rejected";
	ИначеЕсли СтрНачинаетсяС(Имя, "требуетсяподписание") Тогда
		Возврат "our_sign";
	ИначеЕсли СтрНачинаетсяС(Имя, "требуется") Тогда
		Возврат "our_send";
	ИначеЕсли СтрНачинаетсяС(Имя, "ожидается") Тогда
		Возврат "waiting";
	КонецЕсли;
	Возврат "other";

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НовыйДиагноз(Состояние)

	Диагноз = Новый Структура;
	Диагноз.Вставить("Код", "");
	Диагноз.Вставить("Титул", "");
	Диагноз.Вставить("ЧейХод", "none");
	Диагноз.Вставить("Контрагент", Неопределено);
	Диагноз.Вставить("Дней", 0);
	Диагноз.Вставить("С", Дата(1, 1, 1));
	Диагноз.Вставить("Причина", "");
	Диагноз.Вставить("Действие", "none");
	Диагноз.Вставить("Перевозчик", Состояние.Перевозчик);
	Диагноз.Вставить("Грузополучатель", Состояние.Грузополучатель);
	Возврат Диагноз;

КонецФункции

Функция Установить(Диагноз, Код, Титул, ЧейХод, Действие)

	Диагноз.Код = Код;
	Диагноз.Титул = Титул;
	Диагноз.ЧейХод = ЧейХод;
	Диагноз.Действие = Действие;
	Если ЧейХод = "carrier" Тогда
		Диагноз.Контрагент = Диагноз.Перевозчик;
	ИначеЕсли ЧейХод = "consignee" Тогда
		Диагноз.Контрагент = Диагноз.Грузополучатель;
	КонецЕсли;
	Возврат Диагноз;

КонецФункции

Функция УстановитьСрок(Диагноз, ДатаСобытия, ТекущаяДата)

	Если ЗначениеЗаполнено(ДатаСобытия) Тогда
		Диагноз.С = ДатаСобытия;
		Диагноз.Дней = Макс(0, Цел((НачалоДня(ТекущаяДата) - НачалоДня(ДатаСобытия)) / 86400));
	КонецЕсли;
	Возврат Диагноз;

КонецФункции

// Отказ, пришедший позже титула, от которого отказались. Отказ раньше титула - старый: титул выслан заново.
//
// Параметры:
//  Состояние - см. ИИОЭ_БЭД.НовоеСостояние
//
// Возвращаемое значение:
//  Строка - ОткП, ОткТ3 или пустая строка.
Функция ПоследнийОтказ(Состояние)

	Для Каждого Пара Из СтрРазделить("ОткП:Т1,ОткТ3:Т3", ",") Цикл
		Части = СтрРазделить(Пара, ":");
		Отказ = Состояние.Титулы.Получить(Части[0]);
		Титул = Состояние.Титулы.Получить(Части[1]);
		Если Отказ <> Неопределено И (Титул = Неопределено Или Отказ.Дата >= Титул.Дата) Тогда
			Возврат Части[0];
		КонецЕсли;
	КонецЦикла;
	Возврат "";

КонецФункции

// Исходящий титул ушел оператору: статус Отправлен или более поздний.
//
// Параметры:
//  Титул - Структура - Входящий, Статус, Дата.
//
// Возвращаемое значение:
//  Булево
Функция СообщениеОтправлено(Титул)

	Возврат СтрРазделить("Отправлен,Получен,Подтвержден,Утвержден", ",").Найти(Титул.Статус) <> Неопределено;

КонецФункции

#КонецОбласти
