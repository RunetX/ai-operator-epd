// Инструменты пакета ЭТрН в канале бота (см. ИИО_Пакеты, ИИО_РеестрИнструментов). Без объектов БЭД
// в конфигурации пакет инструментов не регистрирует.

#Область ПрограммныйИнтерфейс

// Регистрирует инструменты пакета в серверном реестре бота. Вызывается ядром.
//
// Параметры:
//  Определения - Массив из см. ИИО_ИнструментыКлиентСервер.НовоеОпределение
Процедура ПриРегистрацииИнструментов(Определения) Экспорт

	Если Не ИИОЭ_БЭД.БЭДПоддерживается() Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Определение Из ИИОЭ_ИнструментыКлиентСервер.Определения() Цикл
		Если Определение.ВБоте Тогда
			Определения.Добавить(Определение);
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры

// Выполняет инструмент пакета. Вызывается ядром в конвейере реестра: аргументы уже без токенов,
// ответ ядро маскирует и пишет в журнал.
//
// Параметры:
//  ИмяИнструмента - Строка
//  Аргументы - Структура, Соответствие
//  Вызов - Структура - См. ИИО_ИнструментыБота.ВыполнитьИнструмент.
//
// Возвращаемое значение:
//  Структура - Ответ для модели до маскирования.
Функция ВыполнитьИнструмент(ИмяИнструмента, Аргументы, Вызов) Экспорт

	Если ИмяИнструмента = "epd_status" Тогда
		Возврат ИИОЭ_СтатусЭПД.Статус(Аргументы, Вызов.Контекст.Кнопки);
	КонецЕсли;
	Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND",
		СтрШаблон(НСтр("ru = 'Инструмент %1 не найден.'"), ИмяИнструмента));

КонецФункции

#КонецОбласти
