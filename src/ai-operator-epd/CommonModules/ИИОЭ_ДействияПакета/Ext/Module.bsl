// Действия пакета ЭТрН для perform (см. ИИО_Пакеты, ИИО_Действия.ДействияПакетов). Выполняются только
// из предпросмотра: «Выполнить» нажимает пользователь.

#Область ПрограммныйИнтерфейс

// Регистрирует действия пакета. Вызывается ядром.
//
// Параметры:
//  Действия - Массив из см. ИИО_Действия.НовоеДействие
Процедура ПриРегистрацииДействий(Действия) Экспорт

	Если Не ИИОЭ_БЭД.БЭДПоддерживается() Тогда
		Возврат;
	КонецЕсли;
	Действия.Добавить(ИИО_Действия.НовоеДействие("epd_send", НСтр("ru = 'Отправить титул ЭТрН оператору ЭДО повторно'"),
		"Изменение", НСтр("ru = 'Изменение'"), "ИИОЭ_ДействияЭПД", Истина));

КонецПроцедуры

#КонецОбласти
