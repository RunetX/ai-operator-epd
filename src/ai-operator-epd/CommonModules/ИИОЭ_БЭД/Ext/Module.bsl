// Адаптер к объектам БЭД: ЭТрН по документам-основаниям и состояние документооборота по титулам.
// Читает только метаданные БЭД, служебные функции БЭД не вызывает: их состав меняется между релизами.
// Сначала проверяет доступ пользователя к ЭТрН запросом с РАЗРЕШЕННЫЕ, затем читает сообщения и регистры ЭДО
// в привилегированном режиме - так же, как сама БЭД (ОбменСГИСЭПД.ПолучитьТитулыПоДокументу).

#Область ПрограммныйИнтерфейс

// Есть ли в конфигурации объекты БЭД, которые читает пакет. Без них пакет не регистрирует инструменты.
//
// Возвращаемое значение:
//  Булево
Функция БЭДПоддерживается() Экспорт

	Если Метаданные.Документы.Найти("ЭлектроннаяТранспортнаяНакладная") = Неопределено
		Или Метаданные.Документы.Найти("СообщениеЭДО") = Неопределено
		Или Метаданные.Перечисления.Найти("ТипыЭлементовРегламентаЭДО") = Неопределено
		Или Метаданные.Перечисления.Найти("СостоянияДокументовЭДО") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Регистры = СтрРазделить("ОбъектыУчетаДокументовЭДО,СостоянияДокументовЭДО,ОшибкиПередачиЭДО", ",");
	Для Каждого ИмяРегистра Из Регистры Цикл
		Если Метаданные.РегистрыСведений.Найти(ИмяРегистра) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Титулы = Метаданные.Перечисления.ТипыЭлементовРегламентаЭДО.ЗначенияПеречисления;
	Для Каждого Имя Из СтрРазделить("ЭТрН_Титул1,ЭТрН_Титул2,ЭТрН_Титул3,ЭТрН_Титул4,ЭТрН_ОткП", ",") Цикл
		Если Титулы.Найти(Имя) = Неопределено Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	Возврат Истина;

КонецФункции

// ЭТрН, оформленные по документам-основаниям. Помеченные на удаление не возвращаются.
//
// Параметры:
//  Основания - Массив из ДокументСсылка - Реализации, отгрузки, перемещения, задания на перевозку.
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ДокументСсылка - Основание.
//   * Значение - Массив из ДокументСсылка.ЭлектроннаяТранспортнаяНакладная - Доступные пользователю ЭТрН,
//     новые первыми.
Функция ЭТрНПоОснованиям(Основания) Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Основания.ДокументОснование КАК Основание,
	|	ЭТрН.Ссылка КАК ЭТрН,
	|	ЭТрН.Дата КАК Дата
	|ИЗ
	|	Документ.ЭлектроннаяТранспортнаяНакладная.ДокументыОснования КАК Основания
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектроннаяТранспортнаяНакладная КАК ЭТрН
	|		ПО Основания.Ссылка = ЭТрН.Ссылка
	|ГДЕ
	|	Основания.ДокументОснование В (&Основания)
	|	И НЕ ЭТрН.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("Основания", Основания);
	Результат = Новый Соответствие;
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЭТрН = Результат.Получить(Выборка.Основание);
		Если ЭТрН = Неопределено Тогда
			ЭТрН = Новый Массив;
			Результат.Вставить(Выборка.Основание, ЭТрН);
		КонецЕсли;
		Если ЭТрН.Найти(Выборка.ЭТрН) = Неопределено Тогда
			ЭТрН.Добавить(Выборка.ЭТрН);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Состояние документооборота ЭТрН для диагностики: реквизиты накладной, последние сообщения по титулам,
// состояние электронного документа, ошибка оператора. ЭТрН, недоступные пользователю, не возвращаются.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//   * Значение - см. НовоеСостояние
Функция СостоянияЭТрН(Ссылки) Экспорт

	Состояния = Новый Соответствие;
	Доступные = Новый Массив;
	Выборка = РеквизитыЭТрН(Ссылки).Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояние = НовоеСостояние();
		ЗаполнитьЗначенияСвойств(Состояние, Выборка);
		Состояния.Вставить(Выборка.Ссылка, Состояние);
		Доступные.Добавить(Выборка.Ссылка);
	КонецЦикла;
	Если Доступные.Количество() = 0 Тогда
		Возврат Состояния;
	КонецЕсли;

	// Доступ к накладным проверен выше; сообщения и регистры ЭДО закрыты ролями пользователей торговли.
	УстановитьПривилегированныйРежим(Истина);
	Результаты = ДанныеЭДО(Доступные);
	УстановитьПривилегированныйРежим(Ложь);

	Выборка = Результаты.ЭлектронныеДокументы.Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояние = Состояния.Получить(Выборка.ЭТрН);
		Состояние.ЕстьЭлектронныйДокумент = Истина;
		Состояние.СостояниеЭДО = ИмяЗначения(Выборка.Состояние);
		Состояние.ПредставлениеСостоянияЭДО = Строка(Выборка.Состояние);
		Состояние.ДатаСостояния = Выборка.ДатаИзменения;
		Состояние.Комментарий = Выборка.Комментарий;
	КонецЦикла;

	Выборка = Результаты.Сообщения.Выбрать();
	Пока Выборка.Следующий() Цикл
		Титул = ТитулПоТипуЭлемента(ИмяЗначения(Выборка.ТипЭлементаРегламента));
		Если Не ЗначениеЗаполнено(Титул) Тогда
			Продолжить;
		КонецЕсли;
		// Сообщения упорядочены по дате: позднее сообщение по тому же титулу (исправление, повтор) заменяет раннее.
		// Дата титула - последнее событие по сообщению: для отправленного - смена статуса на «Отправлен».
		Состояния.Получить(Выборка.ЭТрН).Титулы.Вставить(Титул, Новый Структура("Входящий, Статус, Дата",
			Выборка.Входящий, ИмяЗначения(Выборка.Статус), Выборка.Дата));
	КонецЦикла;

	// У документооборота может быть несколько ошибок: они собираются в одну, блокирующая, если блокирует любая.
	Выборка = Результаты.Ошибки.Выбрать();
	Пока Выборка.Следующий() Цикл
		Состояние = Состояния.Получить(Выборка.ЭТрН);
		Ошибка = ОшибкаОператора(Выборка.КодОшибки, Выборка.ОписаниеОшибки);
		Если Состояние.ОшибкаОператора = Неопределено Тогда
			Состояние.ОшибкаОператора = Ошибка;
		ИначеЕсли СтрНайти(Состояние.ОшибкаОператора.Текст, Ошибка.Текст) = 0 Тогда
			Состояние.ОшибкаОператора.Текст = Состояние.ОшибкаОператора.Текст + Символы.ПС + Ошибка.Текст;
			Состояние.ОшибкаОператора.Блокирующая = Состояние.ОшибкаОператора.Блокирующая Или Ошибка.Блокирующая;
		КонецЕсли;
	КонецЦикла;

	Возврат Состояния;

КонецФункции

// Данные водителей из титула грузоотправителя (регистр ЗначенияРеквизитовДокументовЭПД). Нужны только для маскирования:
// ФИО и номер удостоверения могут встретиться в тексте ошибки оператора или в причине отказа.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.ЭлектроннаяТранспортнаяНакладная - ЭТрН; недоступные пользователю пропускаются.
//
// Возвращаемое значение:
//  Массив из Структура - ФИО, фамилии и номера удостоверений водителей с пометкой вида ПДн,
//    см. ИИО_Ответ.ЗначениеСПДн.
Функция ДанныеВодителей(Ссылки) Экспорт

	Результат = Новый Массив;
	Если Метаданные.РегистрыСведений.Найти("ЗначенияРеквизитовДокументовЭПД") = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Значения.Документ КАК Документ,
	|	Значения.НомерСтрокиРеквизита КАК НомерСтроки,
	|	Значения.ИмяРеквизита КАК ИмяРеквизита,
	|	Значения.ЗначениеРеквизитаСтрока КАК Значение
	|ИЗ
	|	РегистрСведений.ЗначенияРеквизитовДокументовЭПД КАК Значения
	|ГДЕ
	|	Значения.Документ В (&Ссылки)
	|	И Значения.ИмяТабличнойЧасти = &ИмяТабличнойЧасти
	|
	|УПОРЯДОЧИТЬ ПО
	|	Документ,
	|	НомерСтроки";
	// Значения титула закрыты ролями пользователей торговли: читаются привилегированно, но только по ЭТрН,
	// доступным пользователю.
	Запрос.УстановитьПараметр("Ссылки", РеквизитыЭТрН(Ссылки).Выгрузить().ВыгрузитьКолонку("Ссылка"));
	Запрос.УстановитьПараметр("ИмяТабличнойЧасти", "ТитулГрузоотправителяВодители");
	УстановитьПривилегированныйРежим(Истина);
	Выборка = Запрос.Выполнить().Выбрать();
	УстановитьПривилегированныйРежим(Ложь);

	Водители = Новый Соответствие;
	Пока Выборка.Следующий() Цикл
		Ключ = Строка(Выборка.Документ.УникальныйИдентификатор()) + "|" + Формат(Выборка.НомерСтроки, "ЧГ=0");
		Водитель = Водители.Получить(Ключ);
		Если Водитель = Неопределено Тогда
			Водитель = Новый Структура("Фамилия, Имя, Отчество, СерияВУ, НомерВУ", "", "", "", "", "");
			Водители.Вставить(Ключ, Водитель);
		КонецЕсли;
		Если Водитель.Свойство(Выборка.ИмяРеквизита) Тогда
			Водитель[Выборка.ИмяРеквизита] = СокрЛП(Выборка.Значение);
		КонецЕсли;
	КонецЦикла;
	Для Каждого КлючИЗначение Из Водители Цикл
		Водитель = КлючИЗначение.Значение;
		ДобавитьНепустое(Результат, СокрЛП(СтрШаблон("%1 %2 %3", Водитель.Фамилия, Водитель.Имя, Водитель.Отчество)),
			"ФИО");
		ДобавитьНепустое(Результат, Водитель.Фамилия, "ФИО");
		ДобавитьНепустое(Результат, СокрЛП(Водитель.СерияВУ + " " + Водитель.НомерВУ), "Документ");
		ДобавитьНепустое(Результат, Водитель.НомерВУ, "Документ");
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Пустое состояние ЭТрН.
//
// Возвращаемое значение:
//  Структура:
//   * Ссылка - ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//   * Номер - Строка - Номер документа в базе.
//   * НомерЭТрН - Строка - Номер транспортной накладной в титуле грузоотправителя.
//   * Дата - Дата
//   * ПометкаУдаления - Булево
//   * ЭтоВходящий - Булево
//   * Организация - СправочникСсылка.Организации
//   * Перевозчик - СправочникСсылка.Контрагенты, Произвольный
//   * Грузополучатель - СправочникСсылка.Контрагенты, Произвольный
//   * ТекущийШаг - Строка - Шаг документооборота БЭД: Оформление, Погрузка, Приемка, Разгрузка.
//   * ТекущийШагВыполнен - Булево
//   * ЕстьЭлектронныйДокумент - Булево
//   * СостояниеЭДО - Строка - Имя значения перечисления СостоянияДокументовЭДО.
//   * ПредставлениеСостоянияЭДО - Строка
//   * ДатаСостояния - Дата
//   * Комментарий - Строка - Комментарий к состоянию: причина отказа контрагента.
//   * Титулы - Соответствие из КлючИЗначение - Ключ: Т1, Т2, Т3, Т4, ОткП, ОткТ3, ОткГО; значение - Структура
//     с полями Входящий, Статус (имя значения СтатусыСообщенийЭДО), Дата.
//   * ОшибкаОператора - Структура, Неопределено - Поля Код, Текст, Блокирующая.
Функция НовоеСостояние() Экспорт

	Состояние = Новый Структура;
	Состояние.Вставить("Ссылка");
	Состояние.Вставить("Номер", "");
	Состояние.Вставить("НомерЭТрН", "");
	Состояние.Вставить("Дата", Дата(1, 1, 1));
	Состояние.Вставить("ПометкаУдаления", Ложь);
	Состояние.Вставить("ЭтоВходящий", Ложь);
	Состояние.Вставить("Организация");
	Состояние.Вставить("Перевозчик");
	Состояние.Вставить("Грузополучатель");
	Состояние.Вставить("ТекущийШаг", "");
	Состояние.Вставить("ТекущийШагВыполнен", Ложь);
	Состояние.Вставить("ЕстьЭлектронныйДокумент", Ложь);
	Состояние.Вставить("СостояниеЭДО", "");
	Состояние.Вставить("ПредставлениеСостоянияЭДО", "");
	Состояние.Вставить("ДатаСостояния", Дата(1, 1, 1));
	Состояние.Вставить("Комментарий", "");
	Состояние.Вставить("Титулы", Новый Соответствие);
	Состояние.Вставить("ОшибкаОператора", Неопределено);
	Возврат Состояние;

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция РеквизитыЭТрН(Ссылки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЭТрН.Ссылка КАК Ссылка,
	|	ЭТрН.Номер КАК Номер,
	|	ЭТрН.ТитулГрузоотправителяТранспортнаяНакладнаяНомер КАК НомерЭТрН,
	|	ЭТрН.Дата КАК Дата,
	|	ЭТрН.ПометкаУдаления КАК ПометкаУдаления,
	|	ЭТрН.ЭтоВходящий КАК ЭтоВходящий,
	|	ЭТрН.Организация КАК Организация,
	|	ЭТрН.СсылкаТитулГрузоотправителяПеревозчик КАК Перевозчик,
	|	ЭТрН.СсылкаТитулГрузоотправителяГрузополучатель КАК Грузополучатель,
	|	ЭТрН.ТекущийШаг КАК ТекущийШаг,
	|	ЭТрН.ТекущийШагВыполнен КАК ТекущийШагВыполнен
	|ИЗ
	|	Документ.ЭлектроннаяТранспортнаяНакладная КАК ЭТрН
	|ГДЕ
	|	ЭТрН.Ссылка В (&Ссылки)";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Возврат Запрос.Выполнить();

КонецФункции

// Электронные документы, сообщения по титулам и ошибки оператора. Связь ошибки с документом - по идентификатору
// документооборота, а не по ссылке: так их пишет синхронизация ЭДО.
//
// Параметры:
//  Ссылки - Массив из ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//
// Возвращаемое значение:
//  Структура:
//   * ЭлектронныеДокументы - РезультатЗапроса
//   * Сообщения - РезультатЗапроса
//   * Ошибки - РезультатЗапроса
Функция ДанныеЭДО(Ссылки)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Объекты.ОбъектУчета КАК ЭТрН,
	|	Объекты.ЭлектронныйДокумент КАК ЭлектронныйДокумент
	|ПОМЕСТИТЬ ВТЭлектронныеДокументы
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК Объекты
	|ГДЕ
	|	Объекты.ОбъектУчета В (&Ссылки)
	|	И Объекты.Актуальный
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЭлектронныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭлектронныеДокументыЭТрН.ЭТрН КАК ЭТрН,
	|	ЕСТЬNULL(Состояния.Состояние, НЕОПРЕДЕЛЕНО) КАК Состояние,
	|	ЕСТЬNULL(Состояния.ДатаИзменения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаИзменения,
	|	ЕСТЬNULL(Состояния.Комментарий, """") КАК Комментарий
	|ИЗ
	|	ВТЭлектронныеДокументы КАК ЭлектронныеДокументыЭТрН
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СостоянияДокументовЭДО КАК Состояния
	|		ПО ЭлектронныеДокументыЭТрН.ЭлектронныйДокумент = Состояния.ЭлектронныйДокумент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭлектронныеДокументыЭТрН.ЭТрН КАК ЭТрН,
	|	Сообщения.ТипЭлементаРегламента КАК ТипЭлементаРегламента,
	|	Сообщения.Направление = ЗНАЧЕНИЕ(Перечисление.НаправленияЭДО.Входящий) КАК Входящий,
	|	Сообщения.Статус КАК Статус,
	|	ВЫБОР
	|		КОГДА Сообщения.ДатаИзмененияСтатуса > Сообщения.Дата
	|			ТОГДА Сообщения.ДатаИзмененияСтатуса
	|		ИНАЧЕ Сообщения.Дата
	|	КОНЕЦ КАК Дата
	|ИЗ
	|	ВТЭлектронныеДокументы КАК ЭлектронныеДокументыЭТрН
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СообщениеЭДО КАК Сообщения
	|		ПО ЭлектронныеДокументыЭТрН.ЭлектронныйДокумент = Сообщения.ЭлектронныйДокумент
	|ГДЕ
	|	НЕ Сообщения.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сообщения.МоментВремени
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЭлектронныеДокументыЭТрН.ЭТрН КАК ЭТрН,
	|	Ошибки.КодОшибки КАК КодОшибки,
	|	Ошибки.ОписаниеОшибки КАК ОписаниеОшибки
	|ИЗ
	|	ВТЭлектронныеДокументы КАК ЭлектронныеДокументыЭТрН
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументИсходящийЭДО КАК ИсходящиеДокументы
	|		ПО ЭлектронныеДокументыЭТрН.ЭлектронныйДокумент = ИсходящиеДокументы.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.ОшибкиПередачиЭДО КАК Ошибки
	|		ПО (ИсходящиеДокументы.ИдентификаторДокументооборота = Ошибки.ИдентификаторДокументооборота)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ошибки.КодОшибки,
	|	Ошибки.ИдентификаторОшибки";
	Запрос.УстановитьПараметр("Ссылки", Ссылки);
	Пакет = Запрос.ВыполнитьПакет();

	Результаты = Новый Структура;
	Результаты.Вставить("ЭлектронныеДокументы", Пакет[1]);
	Результаты.Вставить("Сообщения", Пакет[2]);
	Результаты.Вставить("Ошибки", Пакет[3]);
	Возврат Результаты;

КонецФункции

// Титул по имени значения ТипыЭлементовРегламентаЭДО. Дополнительные титулы (после переадресовки) считаются
// основными: для диагностики важно, получен ли титул, а не его версия.
//
// Параметры:
//  ИмяТипа - Строка - Например, ЭТрН_Титул2 или ЭТрН_ДопТитул3.
//
// Возвращаемое значение:
//  Строка - Т1, Т2, Т3, Т4, ОткП, ОткТ3, ОткГО или пустая строка для прочих элементов.
Функция ТитулПоТипуЭлемента(ИмяТипа)

	Соответствие = Новый Соответствие;
	Соответствие.Вставить("ЭТрН_Титул1", "Т1");
	Соответствие.Вставить("ЭТрН_Титул2", "Т2");
	Соответствие.Вставить("ЭТрН_Титул3", "Т3");
	Соответствие.Вставить("ЭТрН_ДопТитул3", "Т3");
	Соответствие.Вставить("ЭТрН_Титул4", "Т4");
	Соответствие.Вставить("ЭТрН_ДопТитул4", "Т4");
	Соответствие.Вставить("ЭТрН_ОткП", "ОткП");
	Соответствие.Вставить("ЭТрН_ОткТ3", "ОткТ3");
	Соответствие.Вставить("ЭТрН_ОткГО", "ОткГО");
	Титул = Соответствие.Получить(ИмяТипа);
	Возврат ?(Титул = Неопределено, "", Титул);

КонецФункции

// Ошибка оператора из регистра ОшибкиПередачиЭДО. Для ЭПД описание - JSON {code, blocking, text}.
//
// Параметры:
//  КодОшибки - Строка
//  ОписаниеОшибки - Строка
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка
//   * Текст - Строка
//   * Блокирующая - Булево - Повторная отправка без исправления не поможет.
Функция ОшибкаОператора(КодОшибки, ОписаниеОшибки)

	Ошибка = Новый Структура("Код, Текст, Блокирующая", СокрЛП(КодОшибки), СокрЛП(ОписаниеОшибки), Истина);
	// Описание не в формате ЭПД (не JSON-объект) остается как есть и считается блокирующим.
	Если Не СтрНачинаетсяС(Ошибка.Текст, "{") Или Не СтрЗаканчиваетсяНа(Ошибка.Текст, "}") Тогда
		Возврат Ошибка;
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ошибка.Текст);
	Попытка
		Описание = ПрочитатьJSON(Чтение, Истина);
	Исключение
		Чтение.Закрыть();
		ИИО_ЖурналВызовСервера.ЗаписатьОшибкуПакета("ИИОЭ_БЭД",
			ОбработкаОшибок.ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат Ошибка;
	КонецПопытки;
	Чтение.Закрыть();
	Если ТипЗнч(Описание) <> Тип("Соответствие") Тогда
		Возврат Ошибка;
	КонецЕсли;
	Если ЗначениеЗаполнено(Описание.Получить("code")) Тогда
		Ошибка.Код = Строка(Описание.Получить("code"));
	КонецЕсли;
	Если ЗначениеЗаполнено(Описание.Получить("text")) Тогда
		Ошибка.Текст = Строка(Описание.Получить("text"));
	КонецЕсли;
	Ошибка.Блокирующая = Описание.Получить("blocking") <> Ложь;
	Возврат Ошибка;

КонецФункции

Функция ИмяЗначения(Значение)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат "";
	КонецЕсли;
	Возврат ОбщегоНазначения.ИмяЗначенияПеречисления(Значение);

КонецФункции

Процедура ДобавитьНепустое(Массив, Значение, ВидПДн)

	Если Не ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Элемент Из Массив Цикл
		Если Элемент.value = Значение Тогда
			Возврат;
		КонецЕсли;
	КонецЦикла;
	Массив.Добавить(ИИО_Ответ.ЗначениеСПДн(Значение, ВидПДн));

КонецПроцедуры

#КонецОбласти
