// Определения инструментов пакета ЭТрН: одна схема для канала MCP (ИИОЭ_ПакетКлиент) и канала бота
// (ИИОЭ_ИнструментыБота). Описания для модели - в макете ИИОЭ_ОписанияИнструментов.

#Область ПрограммныйИнтерфейс

// Определения инструментов пакета.
//
// Возвращаемое значение:
//  Массив из см. ИИО_ИнструментыКлиентСервер.НовоеОпределение
Функция Определения() Экспорт

	Определения = Новый Массив;
	Свойства = Новый Структура;
	Свойства.Вставить("ref", ИИО_ИнструментыКлиентСервер.СвойствоСхемы("string",
		"Реализация, отгрузка или сама ЭТрН: строка ref (Документ.РеализацияТоваровУслуг:<УИД>) "
		+ "из ответа инструмента или из контекста обсуждения."));
	Определения.Добавить(ИИО_ИнструментыКлиентСервер.НовоеОпределение("epd_status",
		ИИО_ИнструментыКлиентСервер.СхемаОбъекта(Свойства, "ref"), "ИИОЭ_ПакетКлиент.СтатусЭПД", , Истина));
	Возврат Определения;

КонецФункции

#КонецОбласти
