// Инструмент epd_status: почему ЭТрН по документу не дошла и что сделать. Один обработчик
// для каналов MCP и бота: в боте он еще добавляет кнопки «Открыть ЭТрН» и «Предпросмотр».

#Область ПрограммныйИнтерфейс

// Статус ЭТрН по реализации (или другому основанию) либо по самой ЭТрН.
//
// Параметры:
//  Аргументы - Структура, Соответствие - ref: строка ref или {"ref": ...}.
//  Кнопки - Массив, Неопределено - Кнопки ответа бота (см. ИИО_РеестрИнструментов.НоваяКнопка);
//    Неопределено - канал MCP, кнопок нет.
//
// Возвращаемое значение:
//  Структура - Ответ для модели после ИИО_Ответ.ДанныеДляМодели или ошибка, см. ИИО_ОтветКлиентСервер.Ошибка.
Функция Статус(Аргументы, Кнопки = Неопределено) Экспорт

	Значение = ИИО_ОтветКлиентСервер.Аргумент(Аргументы, "ref");
	Если ТипЗнч(Значение) = Тип("Структура") Или ТипЗнч(Значение) = Тип("Соответствие") Тогда
		Значение = ИИО_ОтветКлиентСервер.Аргумент(Значение, "ref");
	КонецЕсли;
	Ссылка = ИИО_Ответ.СсылкаИзСтроки(Значение);
	Если Ссылка = Неопределено Тогда
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT", НСтр("ru = 'Не задана ссылка ref.'"),
			ПодсказкаПоСсылке());
	КонецЕсли;

	Если ТипЗнч(Ссылка) = Тип("ДокументСсылка.ЭлектроннаяТранспортнаяНакладная") Тогда
		Основание = Неопределено;
		Накладные = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка);
	ИначеЕсли ЭтоОснованиеЭТрН(Ссылка) Тогда
		Если Не ДокументДоступен(Ссылка) Тогда
			Возврат ОшибкаНеНайден();
		КонецЕсли;
		Основание = Ссылка;
		Накладные = ИИОЭ_БЭД.ЭТрНПоОснованиям(ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Ссылка)).Получить(Ссылка);
		Накладные = ?(Накладные = Неопределено, Новый Массив, Накладные);
	Иначе
		Возврат ИИО_ОтветКлиентСервер.Ошибка("INVALID_ARGUMENT",
			СтрШаблон(НСтр("ru = 'ЭТрН не оформляют по объектам вида %1.'"), Ссылка.Метаданные().Представление()),
			ПодсказкаПоСсылке());
	КонецЕсли;

	Ответ = Новый Структура;
	Ответ.Вставить("object", Ссылка);
	Если Накладные.Количество() = 0 Тогда
		Ответ.Вставить("etrn", Новый Массив);
		Ответ.Вставить("diagnosis", Новый Структура("code, whose_turn, action, text", "NO_ETRN", "us", "open",
			НСтр("ru = 'По документу нет ЭТрН. Ее оформляют из документа: «Создать на основании» → «Электронная транспортная накладная».'")));
		ДобавитьКнопкуОткрыть(Кнопки, Основание, НСтр("ru = 'Открыть документ'"));
		Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);
	КонецЕсли;

	Состояния = ИИОЭ_БЭД.СостоянияЭТрН(Накладные);
	Если Состояния.Количество() = 0 Тогда
		Возврат ОшибкаНеНайден();
	КонецЕсли;
	ТекущаяДата = ТекущаяДатаСеанса();
	Элементы = Новый Массив;
	КОтправке = Новый Массив;
	Для Каждого ЭТрН Из Накладные Цикл
		Состояние = Состояния.Получить(ЭТрН);
		Если Состояние = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		Диагноз = ИИОЭ_Диагностика.Диагноз(Состояние, ТекущаяДата);
		Элементы.Добавить(ЭлементОтвета(Состояние, Диагноз));
		Если Диагноз.Действие = "epd_send" Тогда
			КОтправке.Добавить(ЭТрН);
		КонецЕсли;
	КонецЦикла;
	Ответ.Вставить("etrn", Элементы);

	Если КОтправке.Количество() > 0 Тогда
		Если ИИО_Права.ДействиеРазрешено("epd_send") Тогда
			Ответ.Вставить("actions", Новый Массив);
			Ответ.actions.Добавить(Новый Структура("action, refs", "epd_send", КОтправке));
			ДобавитьКнопкуПредпросмотра(Кнопки, КОтправке);
		Иначе
			Ответ.Вставить("action_denied", НСтр("ru = 'Повторную отправку ЭТрН администратор ИИ-оператора этому пользователю не разрешил: отправить можно из формы ЭТрН.'"));
		КонецЕсли;
	КонецЕсли;
	ДобавитьКнопкуОткрыть(Кнопки, Накладные[0], НСтр("ru = 'Открыть ЭТрН'"));
	Ответ.Вставить("hint", НСтр("ru = 'Перескажи diagnosis.text своими словами, не добавляя причин от себя. Действие epd_send выполняется через perform: пользователь подтверждает его в предпросмотре.'"));

	Контекст = ИИОЭ_БЭД.ДанныеВодителей(Накладные);
	Если Контекст.Количество() > 0 Тогда
		Ответ.Вставить("pii_context", Контекст);
	КонецЕсли;
	Возврат ИИО_Ответ.ДанныеДляМодели(Ответ);

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция ЭлементОтвета(Состояние, Диагноз)

	Титулы = Новый Массив;
	Для Каждого Титул Из СтрРазделить("Т1,Т2,Т3,Т4", ",") Цикл
		Данные = Состояние.Титулы.Получить(Титул);
		Элемент = Новый Структура("title, by", КодТитула(Титул), АвторТитула(Титул));
		Если Данные = Неопределено Тогда
			Элемент.Вставить("status", "none");
		Иначе
			Элемент.Вставить("status", СтатусТитула(Данные));
			Элемент.Вставить("date", Данные.Дата);
		КонецЕсли;
		Титулы.Добавить(Элемент);
	КонецЦикла;

	ОписаниеДиагноза = Новый Структура;
	ОписаниеДиагноза.Вставить("code", Диагноз.Код);
	ОписаниеДиагноза.Вставить("title", КодТитула(Диагноз.Титул));
	ОписаниеДиагноза.Вставить("whose_turn", Диагноз.ЧейХод);
	Если ЗначениеЗаполнено(Диагноз.Контрагент) Тогда
		ОписаниеДиагноза.Вставить("counterparty", Диагноз.Контрагент);
	КонецЕсли;
	Если ЗначениеЗаполнено(Диагноз.С) Тогда
		ОписаниеДиагноза.Вставить("since", Диагноз.С);
		ОписаниеДиагноза.Вставить("days", Диагноз.Дней);
	КонецЕсли;
	Если ЗначениеЗаполнено(Диагноз.Причина) Тогда
		ОписаниеДиагноза.Вставить("reason", Диагноз.Причина);
	КонецЕсли;
	ОписаниеДиагноза.Вставить("action", Диагноз.Действие);
	ОписаниеДиагноза.Вставить("text", ТекстДиагноза(Диагноз));

	Элемент = Новый Структура;
	Элемент.Вставить("etrn", Состояние.Ссылка);
	Если ЗначениеЗаполнено(Состояние.НомерЭТрН) Тогда
		Элемент.Вставить("number", Состояние.НомерЭТрН);
	КонецЕсли;
	Элемент.Вставить("titles", Титулы);
	Если ЗначениеЗаполнено(Состояние.ПредставлениеСостоянияЭДО) Тогда
		Элемент.Вставить("edo_state", Состояние.ПредставлениеСостоянияЭДО);
	КонецЕсли;
	Элемент.Вставить("diagnosis", ОписаниеДиагноза);
	Возврат Элемент;

КонецФункции

// Текст диагноза для пересказа моделью: без имен контрагентов (они - в counterparty, маскированно)
// и без текста причины (он - в reason).
//
// Параметры:
//  Диагноз - см. ИИОЭ_Диагностика.Диагноз
//
// Возвращаемое значение:
//  Строка
Функция ТекстДиагноза(Диагноз)

	Срок = "";
	Если ЗначениеЗаполнено(Диагноз.С) Тогда
		Срок = СтрШаблон(НСтр("ru = ' Без движения %1 дн. (с %2).'"), Диагноз.Дней, Формат(Диагноз.С, "ДЛФ=D"));
	КонецЕсли;
	Тексты = Новый Соответствие;
	Тексты.Вставить("DELETED", НСтр("ru = 'ЭТрН помечена на удаление.'"));
	Тексты.Вставить("OTHER", НСтр("ru = 'Состояние документооборота пакет не разбирает: смотри форму ЭТрН.'"));
	Тексты.Вставить("DONE", НСтр("ru = 'Перевозка закрыта: перевозчик подписал Т4 о выдаче груза.'"));
	Тексты.Вставить("T1_NOT_FORMED", НСтр("ru = 'Титул грузоотправителя (Т1) не сформирован и не отправлен. Сделать: открыть ЭТрН и нажать «Отправить через ЭДО».'"));
	Тексты.Вставить("T1_NOT_SIGNED", НСтр("ru = 'Т1 сформирован, но не подписан. Сделать: открыть ЭТрН и подписать титул сертификатом организации.'"));
	Тексты.Вставить("T1_NOT_SENT", НСтр("ru = 'Т1 подписан, но не ушел оператору ЭДО. Сделать: повторить отправку (действие epd_send).'"));
	Тексты.Вставить("T1_REJECTED", НСтр("ru = 'Перевозчик отказался принять груз по Т1 (причина - в reason). Сделать: открыть ЭТрН, исправить и оформить заново.'"));
	Тексты.Вставить("T3_REJECTED", НСтр("ru = 'Грузополучатель отказался от приемки или указал замечания в Т3 (причина - в reason). Сделать: открыть ЭТрН и связаться с грузополучателем.'"));
	Тексты.Вставить("WAIT_T2", НСтр("ru = 'Т1 отправлен, ждем титул перевозчика о приеме груза (Т2). Ход перевозчика.'"));
	Тексты.Вставить("WAIT_T3", НСтр("ru = 'Перевозчик принял груз (Т2), ждем титул грузополучателя о приемке (Т3). Ход грузополучателя.'"));
	Тексты.Вставить("WAIT_T4", НСтр("ru = 'Грузополучатель принял груз (Т3), ждем титул перевозчика о выдаче (Т4). Ход перевозчика.'"));
	Если Диагноз.Код = "T1_ERROR" И Диагноз.Действие = "epd_send" Тогда
		Текст = НСтр("ru = 'Оператор ЭДО не принял Т1 (текст ошибки - в reason), ошибка не требует исправления данных. Сделать: повторить отправку (действие epd_send).'");
	ИначеЕсли Диагноз.Код = "T1_ERROR" Тогда
		Текст = НСтр("ru = 'Оператор ЭДО отклонил Т1 (текст ошибки - в reason). Сделать: открыть ЭТрН, исправить данные и отправить заново.'");
	Иначе
		Текст = Тексты.Получить(Диагноз.Код);
	КонецЕсли;
	Возврат ?(Текст = Неопределено, "", Текст) + ?(Диагноз.Действие = "none", "", Срок);

КонецФункции

Функция КодТитула(Титул)

	Возврат СтрЗаменить(Титул, "Т", "T");

КонецФункции

Функция АвторТитула(Титул)

	Если Титул = "Т1" Тогда
		Возврат "us";
	ИначеЕсли Титул = "Т3" Тогда
		Возврат "consignee";
	КонецЕсли;
	Возврат "carrier";

КонецФункции

// Статус титула для модели.
//
// Параметры:
//  Данные - Структура - Входящий, Статус, Дата.
//
// Возвращаемое значение:
//  Строка - received, formed, signed, ready, sent или имя статуса БЭД.
Функция СтатусТитула(Данные)

	Если Данные.Входящий Тогда
		Возврат "received";
	КонецЕсли;
	Статусы = Новый Соответствие;
	Статусы.Вставить("Сформирован", "formed");
	Статусы.Вставить("Подписан", "signed");
	Статусы.Вставить("ЧастичноПодписан", "signed");
	Статусы.Вставить("ПодготовленКОтправке", "ready");
	Статусы.Вставить("Отправлен", "sent");
	Статусы.Вставить("Получен", "sent");
	Статусы.Вставить("Подтвержден", "sent");
	Статусы.Вставить("Утвержден", "sent");
	Статус = Статусы.Получить(Данные.Статус);
	Возврат ?(Статус = Неопределено, Данные.Статус, Статус);

КонецФункции

Функция ЭтоОснованиеЭТрН(Ссылка)

	ТипОснования = Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная.ТабличныеЧасти.ДокументыОснования.Реквизиты
		.ДокументОснование.Тип;
	Возврат ТипОснования.СодержитТип(ТипЗнч(Ссылка));

КонецФункции

Функция ДокументДоступен(Ссылка)

	Запрос = Новый Запрос(СтрШаблон(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Документы.Ссылка КАК Ссылка
		|ИЗ
		|	%1 КАК Документы
		|ГДЕ
		|	Документы.Ссылка = &Ссылка", Ссылка.Метаданные().ПолноеИмя()));
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Возврат Не Запрос.Выполнить().Пустой();

КонецФункции

Процедура ДобавитьКнопкуОткрыть(Кнопки, Ссылка, Заголовок)

	Если Кнопки = Неопределено Или Ссылка = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Кнопки.Добавить(ИИО_РеестрИнструментов.НоваяКнопка("open", Заголовок, "open_object",
		Новый Структура("ref, view", ИИО_Ответ.СсылкаВСтроку(Ссылка), "form")));

КонецПроцедуры

Процедура ДобавитьКнопкуПредпросмотра(Кнопки, Накладные)

	Если Кнопки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Ссылки = Новый Массив;
	Для Каждого ЭТрН Из Накладные Цикл
		Ссылки.Добавить(ИИО_Ответ.СсылкаВСтроку(ЭТрН));
	КонецЦикла;
	Кнопки.Добавить(ИИО_РеестрИнструментов.НоваяКнопка("preview", НСтр("ru = 'Предпросмотр'"), "perform",
		Новый Структура("action, refs, dry_run", "epd_send", Ссылки, Ложь)));

КонецПроцедуры

Функция ОшибкаНеНайден()

	Возврат ИИО_ОтветКлиентСервер.Ошибка("NOT_FOUND", НСтр("ru = 'Документ не найден или недоступен пользователю.'"),
		ПодсказкаПоСсылке());

КонецФункции

Функция ПодсказкаПоСсылке()

	Возврат НСтр("ru = 'Передай ref реализации, отгрузки или самой ЭТрН из ответа инструмента или из контекста обсуждения.'");

КонецФункции

#КонецОбласти
