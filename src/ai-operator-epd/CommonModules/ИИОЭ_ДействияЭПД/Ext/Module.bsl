// Обработчик действия epd_send: повторная отправка титула грузоотправителя оператору ЭДО через ИИОЭ_Транспорт.
// Интерфейс - см. ИИО_ДействияПроведение, внешний шаг - см. ИИО_Действия.НовоеДействие.
// Действие необратимо: принятый оператором титул не отзывается.

#Область СлужебныйПрограммныйИнтерфейс

// Применимо ли действие к объектам этого вида.
//
// Параметры:
//  Действие - Строка - Код действия.
//  ОбъектМетаданных - ОбъектМетаданных
//
// Возвращаемое значение:
//  Булево - Истина для ЭТрН.
Функция Применимо(Действие, ОбъектМетаданных) Экспорт

	Возврат ОбъектМетаданных = Метаданные.Документы.ЭлектроннаяТранспортнаяНакладная;

КонецФункции

// Текущие состояния ЭТрН для плана. Недоступные пользователю не возвращаются.
//
// Параметры:
//  ПолноеИмя - Строка - Документ.ЭлектроннаяТранспортнаяНакладная.
//  Ссылки - Массив из ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//
// Возвращаемое значение:
//  Соответствие из КлючИЗначение:
//   * Ключ - ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//   * Значение - см. НовоеСостояниеДействия
Функция Состояния(ПолноеИмя, Ссылки) Экспорт

	Результат = Новый Соответствие;
	ТекущаяДата = ТекущаяДатаСеанса();
	Для Каждого КлючИЗначение Из ИИОЭ_БЭД.СостоянияЭТрН(Ссылки) Цикл
		Диагноз = ИИОЭ_Диагностика.Диагноз(КлючИЗначение.Значение, ТекущаяДата);
		Результат.Вставить(КлючИЗначение.Ключ, НовоеСостояниеДействия(Диагноз, КлючИЗначение.Значение));
	КонецЦикла;
	Возврат Результат;

КонецФункции

// Состояние ЭТрН для данных отката. Хранится в JSON, поэтому только простые значения.
//
// Параметры:
//  Объект - ДокументОбъект.ЭлектроннаяТранспортнаяНакладная
//
// Возвращаемое значение:
//  см. НовоеСостояниеДействия
Функция СостояниеОбъекта(Объект) Экспорт

	Состояние = Состояния(Объект.Метаданные().ПолноеИмя(),
		ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве(Объект.Ссылка)).Получить(Объект.Ссылка);
	Возврат ?(Состояние = Неопределено, НовоеСостояниеДействия(Неопределено, Неопределено), Состояние);

КонецФункции

// Представление состояния для пользователя.
//
// Параметры:
//  Состояние - см. НовоеСостояниеДействия
//
// Возвращаемое значение:
//  Строка
Функция ПредставлениеСостояния(Состояние) Экспорт

	Если ЗначениеЗаполнено(Состояние.edo_state) Тогда
		Возврат Состояние.edo_state;
	КонецЕсли;
	Возврат Состояние.code;

КонецФункции

// Что изменит действие в ЭТрН с этим состоянием.
//
// Параметры:
//  Действие - Строка - Код действия.
//  Состояние - см. НовоеСостояниеДействия
//
// Возвращаемое значение:
//  Структура:
//   * Код - Строка - send или none.
//   * Представление - Строка
//   * Выполнять - Булево
//   * Обратимо - Булево
Функция Изменение(Действие, Состояние) Экспорт

	Если Состояние.action = "epd_send" Тогда
		Возврат НовоеИзменение("send", НСтр("ru = 'Титул грузоотправителя (Т1) будет отправлен оператору ЭДО: отозвать нельзя'"),
			Истина, Ложь);
	ИначеЕсли Состояние.code = "T1_ERROR" Тогда
		Возврат НовоеИзменение("none",
			НСтр("ru = 'Без изменений: оператор отклонил Т1, без исправления данных повторная отправка не поможет'"), Ложь, Истина);
	КонецЕсли;
	Возврат НовоеИзменение("none", НСтр("ru = 'Без изменений: Т1 отправлять не нужно'"), Ложь, Истина);

КонецФункции

// Проверки ЭТрН перед отправкой, кроме общих (блокировка, дата запрета), которые выполняет ИИО_Действия.
//
// Параметры:
//  Действие - Строка - Код действия.
//  Ссылка - ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//  Состояние - см. НовоеСостояниеДействия
//  Ошибки - Массив из Строка
//  Предупреждения - Массив из Строка
Процедура Проверки(Действие, Ссылка, Состояние, Ошибки, Предупреждения) Экспорт

	ТекстОшибки = ИИОЭ_Транспорт.ПочемуОтправкаНевозможна();
	Если ЗначениеЗаполнено(ТекстОшибки) Тогда
		Ошибки.Добавить(ТекстОшибки);
	КонецЕсли;
	Если Состояние.code = "T1_ERROR" Тогда
		Предупреждения.Добавить(НСтр("ru = 'Оператор уже возвращал ошибку по этому титулу: если она повторится, исправьте данные в форме ЭТрН.'"));
	КонецЕсли;

КонецПроцедуры

// Внешний шаг действия: отправка титула оператору. Вызывается ядром до транзакции (стандарт 783 п. 2.3),
// ЭТрН заблокирована для редактирования. Ошибка оператора или связи вызывает исключение.
//
// Параметры:
//  Действие - Строка - Код действия.
//  Ссылка - ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//
// Возвращаемое значение:
//  Структура - См. ИИОЭ_Транспорт.ОтправитьТитулГрузоотправителя.
Функция ВыполнитьВнешнийШаг(Действие, Ссылка) Экспорт

	Если Действие <> "epd_send" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Обработчик ЭТрН не выполняет действие %1.'"), Действие);
	КонецЕсли;
	Возврат ИИОЭ_Транспорт.ОтправитьТитулГрузоотправителя(Ссылка);

КонецФункции

// Отмечает в БЭД отправку, выполненную внешним шагом. Вызывается в транзакции.
//
// Параметры:
//  Действие - Строка - Код действия.
//  Объект - ДокументОбъект.ЭлектроннаяТранспортнаяНакладная - Заблокированная ЭТрН.
Процедура ВыполнитьДействие(Действие, Объект) Экспорт

	Если Действие <> "epd_send" Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Обработчик ЭТрН не выполняет действие %1.'"), Действие);
	КонецЕсли;
	ИИОЭ_Транспорт.ОтметитьОтправкуТитула(Объект);

КонецПроцедуры

// Обратное действие для отката: отправку не откатить.
//
// Параметры:
//  Действие - Строка - Код выполненного действия.
//  СостояниеДо - Структура - Состояние до изменения.
//
// Возвращаемое значение:
//  Структура:
//   * Действие - Строка - Пустая строка: откатить нельзя.
//   * Причина - Строка
Функция ОбратноеДействие(Действие, СостояниеДо) Экспорт

	Возврат Новый Структура("Действие, Причина", "",
		НСтр("ru = 'Отправленный титул не отзывается: его уже получил оператор ЭДО.'"));

КонецФункции

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Состояние ЭТрН для плана и данных отката.
//
// Параметры:
//  Диагноз - см. ИИОЭ_Диагностика.Диагноз, Неопределено
//  Состояние - см. ИИОЭ_БЭД.НовоеСостояние, Неопределено
//
// Возвращаемое значение:
//  Структура:
//   * code - Строка - Код диагноза.
//   * action - Строка - Действие диагноза.
//   * edo_state - Строка - Представление состояния электронного документа.
Функция НовоеСостояниеДействия(Диагноз, Состояние)

	Результат = Новый Структура("code, action, edo_state", "", "none", "");
	Если Диагноз <> Неопределено Тогда
		Результат.code = Диагноз.Код;
		Результат.action = Диагноз.Действие;
	КонецЕсли;
	Если Состояние <> Неопределено Тогда
		Результат.edo_state = Состояние.ПредставлениеСостоянияЭДО;
	КонецЕсли;
	Возврат Результат;

КонецФункции

Функция НовоеИзменение(Код, Представление, Выполнять, Обратимо)

	Возврат Новый Структура("Код, Представление, Выполнять, Обратимо", Код, Представление, Выполнять, Обратимо);

КонецФункции

#КонецОбласти
