// Транспорт титула к оператору ЭДО для действия epd_send. В MVP есть только тестовый оператор
// (tests/mock/edo_mock.py), адрес которого задан в константе ИИОЭ_АдресТестовогоСервераОператораЭДО. Без адреса
// отправка из ИИ-оператора недоступна: в рабочей базе титул отправляют из формы ЭТрН («Отправить через ЭДО»),
// там же подписание сертификатом. Штатный режим через 1С-ЭДО - заготовка.

#Область ПрограммныйИнтерфейс

// Почему действие epd_send сейчас нельзя выполнить.
//
// Возвращаемое значение:
//  Строка - Текст для предпросмотра; пустая строка - отправка возможна.
Функция ПочемуОтправкаНевозможна() Экспорт

	Если ЗначениеЗаполнено(АдресТестовогоСервера()) Тогда
		Возврат "";
	КонецЕсли;
	Возврат НСтр("ru = 'Отправка титула из ИИ-оператора пока работает только с тестовым оператором. Отправьте титул из формы ЭТрН: «Отправить через ЭДО».'");

КонецФункции

// Отправляет последний исходящий титул грузоотправителя (Т1) оператору. Только обращение к оператору: вызывается
// вне транзакции, отметку в БЭД делает ОтметитьОтправкуТитула. Ошибка оператора или связи вызывает исключение
// с текстом для пользователя.
//
// Параметры:
//  ЭТрН - ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//
// Возвращаемое значение:
//  Структура:
//   * ИдентификаторСообщения - Строка - Идентификатор, который вернул оператор.
Функция ОтправитьТитулГрузоотправителя(ЭТрН) Экспорт

	Адрес = АдресТестовогоСервера();
	Если Не ЗначениеЗаполнено(Адрес) Тогда
		ВызватьИсключение ПочемуОтправкаНевозможна();
	КонецЕсли;

	УстановитьПривилегированныйРежим(Истина);
	Титул = ПоследнийТитулГрузоотправителя(ЭТрН);
	УстановитьПривилегированныйРежим(Ложь);
	Если Титул = Неопределено Тогда
		ВызватьИсключение НСтр("ru = 'У ЭТрН нет сформированного титула грузоотправителя: сформируйте его в форме ЭТрН.'");
	КонецЕсли;

	Ответ = ОтправитьНаТестовыйСервер(Адрес, ДанныеОтправки(ЭТрН, Титул));
	Если Ответ.Получить("ok") <> Истина Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Оператор ЭДО не принял титул: %1'"),
			Строка(Ответ.Получить("text")));
	КонецЕсли;
	Возврат Новый Структура("ИдентификаторСообщения", Строка(Ответ.Получить("message_id")));

КонецФункции

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Отмечает отправку последнего исходящего Т1 так же, как синхронизация ЭДО после ответа оператора
// (ЭлектронныеДокументыЭДОСлужебный.ОбработатьОтправленноеСообщение): статус сообщения «Отправлен», состояние
// сообщения по регламенту, ошибки передачи по документообороту очищаются, состояние электронного документа
// пересчитывается. Запись ЭТрН пересчитывает ее шаг и реестр ЭПД (ОбменСГИСЭПД.УстановитьТекущийШаг).
// Вызывается в транзакции; пересчет - служебными функциями БЭД, а если их модулей нет - напрямую. Ошибку функций
// БЭД метод не перехватывает: транзакция действия откатывается целиком (стандарт 783).
// Нужна и генератору состояний в тестах.
//
// Параметры:
//  ЭТрН - ДокументОбъект.ЭлектроннаяТранспортнаяНакладная
Процедура ОтметитьОтправкуТитула(ЭТрН) Экспорт

	УстановитьПривилегированныйРежим(Истина);
	Титул = ПоследнийТитулГрузоотправителя(ЭТрН.Ссылка);
	Если Титул = Неопределено Тогда
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение НСтр("ru = 'У ЭТрН нет сформированного титула грузоотправителя.'");
	КонецЕсли;

	ЭлектронныйДокумент = Титул.ЭлектронныйДокумент.ПолучитьОбъект();
	Сообщение = Титул.Сообщение.ПолучитьОбъект();
	Сообщение.Статус = Перечисления.СтатусыСообщенийЭДО.Отправлен;
	Сообщение.ДатаИзмененияСтатуса = ТекущаяДатаСеанса();
	Сообщение.Состояние = СостояниеОтправленногоСообщения(Сообщение, ЭлектронныйДокумент);
	Сообщение.Записать();

	Если ЗначениеЗаполнено(Титул.ИдентификаторДокументооборота) Тогда
		Набор = РегистрыСведений.ОшибкиПередачиЭДО.СоздатьНаборЗаписей();
		Набор.Отбор.ИдентификаторДокументооборота.Установить(Титул.ИдентификаторДокументооборота);
		Набор.Записать();
	КонецЕсли;

	Если Не ОбновитьСостояниеПоБЭД(Титул.ЭлектронныйДокумент) Тогда
		Запись = РегистрыСведений.СостоянияДокументовЭДО.СоздатьМенеджерЗаписи();
		Запись.ЭлектронныйДокумент = Титул.ЭлектронныйДокумент;
		Запись.Состояние = Перечисления.СостоянияДокументовЭДО.ОжидаетсяПодтверждение;
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Записать();
	КонецЕсли;
	УстановитьПривилегированныйРежим(Ложь);

	ЭТрН.Записать(РежимЗаписиДокумента.Запись);

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция АдресТестовогоСервера()

	УстановитьПривилегированныйРежим(Истина);
	Адрес = СокрЛП(Константы.ИИОЭ_АдресТестовогоСервераОператораЭДО.Получить());
	УстановитьПривилегированныйРежим(Ложь);
	Возврат Адрес;

КонецФункции

// Последнее исходящее сообщение Т1 актуального электронного документа ЭТрН.
//
// Параметры:
//  ЭТрН - ДокументСсылка.ЭлектроннаяТранспортнаяНакладная
//
// Возвращаемое значение:
//  Структура, Неопределено:
//   * Сообщение - ДокументСсылка.СообщениеЭДО
//   * ЭлектронныйДокумент - ДокументСсылка.ЭлектронныйДокументИсходящийЭДО
//   * ИдентификаторДокументооборота - Строка
//   * ИмяФайла - Строка
Функция ПоследнийТитулГрузоотправителя(ЭТрН)

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	Сообщения.Ссылка КАК Сообщение,
	|	Сообщения.ЭлектронныйДокумент КАК ЭлектронныйДокумент,
	|	ЕСТЬNULL(ИсходящиеДокументы.ИдентификаторДокументооборота, """") КАК ИдентификаторДокументооборота,
	|	ЕСТЬNULL(Файлы.ПолноеИмяФайла, """") КАК ИмяФайла
	|ИЗ
	|	РегистрСведений.ОбъектыУчетаДокументовЭДО КАК Объекты
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Документ.СообщениеЭДО КАК Сообщения
	|		ПО Объекты.ЭлектронныйДокумент = Сообщения.ЭлектронныйДокумент
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ЭлектронныйДокументИсходящийЭДО КАК ИсходящиеДокументы
	|		ПО Объекты.ЭлектронныйДокумент = ИсходящиеДокументы.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СообщениеЭДОПрисоединенныеФайлы КАК Файлы
	|		ПО Сообщения.ОсновнойФайл = Файлы.Ссылка
	|ГДЕ
	|	Объекты.ОбъектУчета = &ЭТрН
	|	И Объекты.Актуальный
	|	И Сообщения.ТипЭлементаРегламента = ЗНАЧЕНИЕ(Перечисление.ТипыЭлементовРегламентаЭДО.ЭТрН_Титул1)
	|	И Сообщения.Направление = ЗНАЧЕНИЕ(Перечисление.НаправленияЭДО.Исходящий)
	|	И НЕ Сообщения.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Сообщения.МоментВремени УБЫВ";
	Запрос.УстановитьПараметр("ЭТрН", ЭТрН);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;
	Титул = Новый Структура("Сообщение, ЭлектронныйДокумент, ИдентификаторДокументооборота, ИмяФайла");
	ЗаполнитьЗначенияСвойств(Титул, Выборка);
	Возврат Титул;

КонецФункции

Функция ДанныеОтправки(ЭТрН, Титул)

	Данные = Новый Структура;
	Данные.Вставить("etrn", Строка(ЭТрН.УникальныйИдентификатор()));
	Данные.Вставить("title", "T1");
	Данные.Вставить("file_id", СтрЗаменить(Титул.ИмяФайла, ".xml", ""));
	Данные.Вставить("workflow_id", Титул.ИдентификаторДокументооборота);
	Данные.Вставить("message", Строка(Титул.Сообщение.УникальныйИдентификатор()));
	Возврат Данные;

КонецФункции

// POST на тестовый сервер оператора.
//
// Параметры:
//  Адрес - Строка - Адрес тестового сервера, например http://127.0.0.1:8882.
//  Данные - Структура
//
// Возвращаемое значение:
//  Соответствие - Ответ тестового сервера.
Функция ОтправитьНаТестовыйСервер(Адрес, Данные)

	СтруктураАдреса = ОбщегоНазначенияКлиентСервер.СтруктураURI(Адрес);
	Соединение = Новый HTTPСоединение(СтруктураАдреса.Хост, СтруктураАдреса.Порт, , , , 30);
	Путь = СтруктураАдреса.ПутьНаСервере;
	Путь = ?(СтрЗаканчиваетсяНа(Путь, "/"), Путь, Путь + "/") + "send";
	Запрос = Новый HTTPЗапрос(?(СтрНачинаетсяС(Путь, "/"), Путь, "/" + Путь));
	Запрос.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Данные);
	Запрос.УстановитьТелоИзСтроки(Запись.Закрыть(), КодировкаТекста.UTF8, ИспользованиеByteOrderMark.НеИспользовать);
	Попытка
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
	Исключение
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Оператор ЭДО недоступен: %1'"),
			ОбработкаОшибок.КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	Если Ответ.КодСостояния <> 200 Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = 'Оператор ЭДО ответил кодом %1.'"), Ответ.КодСостояния);
	КонецЕсли;
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
	Результат = ПрочитатьJSON(Чтение, Истина);
	Чтение.Закрыть();
	Возврат ?(ТипЗнч(Результат) = Тип("Соответствие"), Результат, Новый Соответствие);

КонецФункции

Функция СостояниеОтправленногоСообщения(Сообщение, ЭлектронныйДокумент)

	Если Метаданные.ОбщиеМодули.Найти("РегламентыЭДО") = Неопределено Тогда
		// Модуля регламентов нет: отправленное сообщение хранится, как в БЭД 1.9.16.
		Возврат Перечисления.СостоянияСообщенийЭДО.Хранение;
	КонецЕсли;
	Возврат ОбщегоНазначения.ОбщийМодуль("РегламентыЭДО").СостояниеСообщения(Сообщение, ЭлектронныйДокумент);

КонецФункции

// Пересчет состояния электронного документа по действию «Отправить», как после ответа оператора.
//
// Параметры:
//  ЭлектронныйДокумент - ДокументСсылка.ЭлектронныйДокументИсходящийЭДО
//
// Возвращаемое значение:
//  Булево - Ложь, если в конфигурации нет служебных модулей БЭД для пересчета.
Функция ОбновитьСостояниеПоБЭД(ЭлектронныйДокумент)

	Если Метаданные.ОбщиеМодули.Найти("ЭлектронныеДокументыЭДОСлужебный") = Неопределено
		Или Метаданные.ОбщиеМодули.Найти("ОбработкаНеисправностейБЭД") = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Контекст = ОбщегоНазначения.ОбщийМодуль("ОбработкаНеисправностейБЭД").НовыйКонтекстДиагностики();
	Возврат ОбщегоНазначения.ОбщийМодуль("ЭлектронныеДокументыЭДОСлужебный").ОбновитьСостояниеДокументаПоДействию(
		ЭлектронныйДокумент, Перечисления.ДействияПоЭДО.Отправить, Контекст) = Истина;

КонецФункции

#КонецОбласти
