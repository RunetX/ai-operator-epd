// Пакет ИИ-оператора для ЭТрН на объектах БЭД: регистрация инструментов в клиентском реестре канала MCP.

#Область ПрограммныйИнтерфейс

// Регистрирует инструменты пакета в реестре ядра (см. ИИО_Пакеты). Вызывается ядром.
// Без объектов БЭД в конфигурации инструменты не регистрируются.
//
// Параметры:
//  Инструменты - Массив из см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент
Процедура ПриРегистрацииИнструментов(Инструменты) Экспорт

	Если Не ИИОЭ_ЭПДВызовСервера.БЭДПоддерживается() Тогда
		Возврат;
	КонецЕсли;
	Для Каждого Определение Из ИИОЭ_ИнструментыКлиентСервер.Определения() Цикл
		Части = СтрРазделить(Определение.ОбработчикКлиента, ".");
		Инструменты.Добавить(ИИО_РеестрИнструментовКлиент.НовыйИнструмент(Определение.Имя,
			Новый ОписаниеОповещения(Части[1], ИИОЭ_ПакетКлиент), Определение.Схема, Определение.ОтложенныйОтвет));
	КонецЦикла;

КонецПроцедуры

#КонецОбласти

#Область СлужебныйПрограммныйИнтерфейс

// Обработчик инструмента epd_status.
//
// Параметры:
//  ПараметрыОбработчика - Структура - Аргументы и Вызов, см. ИИО_РеестрИнструментовКлиент.НовыйИнструмент.
//  ДополнительныеПараметры - Неопределено
//
// Возвращаемое значение:
//  Структура
Функция СтатусЭПД(ПараметрыОбработчика, ДополнительныеПараметры) Экспорт

	Возврат ИИОЭ_ЭПДВызовСервера.Статус(ПараметрыОбработчика.Аргументы);

КонецФункции

#КонецОбласти
